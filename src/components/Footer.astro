  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-white/40 text-center sm:text-left">
        &copy; {currentYear} Crewtec. All rights reserved.
      </p>
      <nav class="flex items-center gap-4 text-sm text-white/40" aria-label="Legal links">
        <a href="/contact" class="hover:text-white transition-colors duration-150">Privacy Policy</a>
        <span class="text-white/20" aria-hidden="true">|</span>
        <a href="/contact" class="hover:text-white transition-colors duration-150">Terms of Service</a>
        <span class="text-white/20" aria-hidden="true">|</span>
        <a href="/contact" class="hover:text-white transition-colors duration-150">Sitemap</a>
