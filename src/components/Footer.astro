          <span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: #0099EE;"></span>
          IT Solutions
        </h4>
        <ul class="space-y-2.5">
          {itSolutionsTop6.map((s) => (
            <li>
              <a
                href={`/it-solutions/${s.id}`}
                class="text-sm text-white/50 hover:text-white transition-colors duration-150"
              >
                {s.name}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/it-solutions"
          class="inline-block mt-4 text-sm font-medium text-white/40 hover:text-white transition-colors duration-150"
        >
          View all 17 &rarr;
        </a>
      </div>

      <!-- Col 3: Digital Growth -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/80 mb-4 flex items-center gap-2" style="font-family: 'Syne', sans-serif;">
          <span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: #00B4A0;"></span>
          Digital Growth
        </h4>
        <ul class="space-y-2.5">
          {digitalGrowthServices.map((s) => (
            <li>
              <a
                href={`/digital-growth/${s.id}`}
                class="text-sm text-white/50 hover:text-white transition-colors duration-150"
              >
                {s.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/industries" class="text-sm text-white/50 hover:text-white transition-colors duration-150">
              Industries
            </a>
          </li>
          <li>
            <a href="/blog" class="text-sm text-white/50 hover:text-white transition-colors duration-150">
              Blog
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: App Development -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/80 mb-4 flex items-center gap-2" style="font-family: 'Syne', sans-serif;">
          <span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: #6366F1;"></span>
          App Development
        </h4>
        <ul class="space-y-2.5">
          {appServices.map((s) => (
            <li>
              <a
                href={`/app-development/${s.id}`}
                class="text-sm text-white/50 hover:text-white transition-colors duration-150"
              >
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Company -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/80 mb-4" style="font-family: 'Syne', sans-serif;">
          Company
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href="/about" class="text-sm text-white/50 hover:text-white transition-colors duration-150">
              About
            </a>
          </li>
          <li>
            <a href="/contact" class="text-sm text-white/50 hover:text-white transition-colors duration-150">
              Contact
            </a>
          </li>
          <li>
            <a href="/blog" class="text-sm text-white/50 hover:text-white transition-colors duration-150">
              Blog
            </a>
          </li>
          <li>
            <a href="/industries" class="text-sm text-white/50 hover:text-white transition-colors duration-150">
              Industries
            </a>
          </li>
          <li>
            <a href="/contact" class="text-sm text-white/50 hover:text-white transition-colors duration-150">
              Get a Quote
            </a>
          </li>
