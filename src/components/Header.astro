<script>
  // ─── Scroll shadow ────────────────────────────────────────────────────────────
  const header = document.getElementById('site-header');

  function updateHeaderShadow() {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add('shadow-md');
    } else {
      header.classList.remove('shadow-md');
    }
  }

  window.addEventListener('scroll', updateHeaderShadow, { passive: true });
  updateHeaderShadow();

  // ─── Mobile hamburger toggle ──────────────────────────────────────────────────
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', 'false');
  }

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMobileMenu() : openMobileMenu();
  });

  // ─── Mobile accordion ─────────────────────────────────────────────────────────
  document.querySelectorAll('.mobile-accordion').forEach((accordion) => {
    const btn = accordion.querySelector('.mobile-accordion-btn');
    const panel = accordion.querySelector('.mobile-accordion-panel');
    const chevron = accordion.querySelector('.accordion-chevron');

    function toggleAccordion() {
      if (!btn || !panel) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        panel.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      } else {
        panel.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
      }
    }

    btn?.addEventListener('click', toggleAccordion);

    btn?.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ke.preventDefault();
        toggleAccordion();
      }
    });
  });

  // ─── Desktop mega menu: keyboard accessibility ────────────────────────────────
  // Enter/Space forces open; Escape closes. We add/remove a CSS class that
  // mirrors the group-hover state via the <style> block below.
  document.querySelectorAll('[data-mega-trigger]').forEach((trigger) => {
    const parent = trigger.closest('.group');
    if (!parent) return;

    trigger.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ke.preventDefault();
        const isForced = parent.classList.contains('force-open');
        if (isForced) {
          parent.classList.remove('force-open');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          // Close any other open menus first
          document.querySelectorAll('.group.force-open').forEach((el) => {
            el.classList.remove('force-open');
            el.querySelector('[data-mega-trigger]')?.setAttribute('aria-expanded', 'false');
          });
          parent.classList.add('force-open');
          trigger.setAttribute('aria-expanded', 'true');
          // Move focus to first menu item
          const firstLink = parent.querySelector<HTMLAnchorElement>('[role="menuitem"]');
          firstLink?.focus();
        }
      }
      if (ke.key === 'Escape') {
        parent.classList.remove('force-open');
        trigger.setAttribute('aria-expanded', 'false');
        (trigger as HTMLElement).focus();
      }
    });

    // Escape from within the panel
    parent.querySelectorAll('[role="menuitem"]').forEach((item) => {
      item.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          parent.classList.remove('force-open');
          trigger.setAttribute('aria-expanded', 'false');
          (trigger as HTMLElement).focus();
        }
      });
    });
  });

  // ─── Click outside → close keyboard-opened mega menus ────────────────────────
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    document.querySelectorAll('.group.force-open').forEach((el) => {
      if (!el.contains(target)) {
        el.classList.remove('force-open');
        el.querySelector('[data-mega-trigger]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ─── Close mobile menu on viewport resize to desktop ─────────────────────────
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      closeMobileMenu();
    }
  });
</script>

<style>
  /*
   * force-open mirrors the Tailwind group-hover state for keyboard-triggered
   * mega menus. The panel div inside uses opacity-0/invisible/translate-y-2
   * as defaults; group-hover overrides them via Tailwind. We replicate that
   * here for .force-open so keyboard users get the same experience.
   */
  .group.force-open > div[role="menu"] {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) translateX(-50%) !important;
  }
</style>
