  class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0">
        <img src="/logo-nav.svg" alt="Crewtec" class="h-10 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">

        <!-- 1. IT Solutions Mega Menu -->
        <div class="relative group">
          <button
            class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium text-[#0A1628] hover:text-[#0099EE] hover:bg-blue-50 transition-colors duration-150"
            aria-haspopup="true"
            aria-expanded="false"
            data-mega-trigger
          >
            IT Solutions
            <svg class="w-4 h-4 opacity-60 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
