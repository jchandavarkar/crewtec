---
// Header.astro — Crewtec GRC Navigation
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0 flex items-center gap-2">
        <img src="/logo-nav.svg" alt="Crewtec" class="h-10 w-auto" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
        <span class="hidden items-center font-bold text-lg text-[#111111]" style="font-family:'Rajdhani',sans-serif;">Crewtec</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">

        <!-- Services Mega Menu -->
        <div class="relative group">
          <button
            class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium text-[#111111] hover:text-[#DC2626] hover:bg-red-50 transition-colors duration-150"
            aria-haspopup="true" aria-expanded="false" data-mega-trigger
          >
            Services
            <svg class="w-4 h-4 opacity-60 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <div
            class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-[780px] opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200"
            role="menu"
          >
            <div class="h-1 rounded-t-2xl" style="background:linear-gradient(90deg,#D97706,#DC2626,#16A34A);"></div>
            <div class="bg-white rounded-b-2xl shadow-2xl border border-gray-100 p-6">
              <div class="grid grid-cols-3 gap-6">

                <!-- Governance -->
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider mb-3 flex items-center gap-2" style="color:#D97706;">
                    <span class="w-5 h-5 rounded bg-amber-100 flex items-center justify-center font-black text-xs" style="color:#D97706;">G</span>
                    Governance
                  </p>
                  <ul class="space-y-1">
                    {[
                      { href: '/services/ai-governance', icon: '🤖', label: 'AI Governance & ISO 42001', sub: 'ISO/IEC 42001 · AI risk management' },
                      { href: '/services/vciso', icon: '👔', label: 'Virtual CISO (vCISO)', sub: 'Fractional security leadership' },
                      { href: '/services/enterprise-risk', icon: '⚖️', label: 'Enterprise Risk Management', sub: 'Risk registers · board reporting' },
                    ].map(item => (
                      <li>
                        <a href={item.href} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-amber-50 transition-colors group/item" role="menuitem">
                          <span class="flex-shrink-0 w-8 h-8 rounded-md bg-amber-50 flex items-center justify-center text-sm">{item.icon}</span>
                          <div>
                            <span class="font-medium text-sm text-[#111111] group-hover/item:text-[#D97706] transition-colors block">{item.label}</span>
                            <span class="text-xs text-gray-400">{item.sub}</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Security -->
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider mb-3 flex items-center gap-2" style="color:#DC2626;">
                    <span class="w-5 h-5 rounded bg-red-100 flex items-center justify-center font-black text-xs" style="color:#DC2626;">S</span>
                    Security
                  </p>
                  <ul class="space-y-1">
                    {[
                      { href: '/services/iso-27001-consulting', icon: '🏆', label: 'ISO 27001 Consulting', sub: 'Certification in 12–16 weeks' },
                      { href: '/services/gap-assessment', icon: '🔍', label: 'Gap Assessment', sub: 'Risk-scored baseline in 2 weeks' },
                      { href: '/services/penetration-testing', icon: '🎯', label: 'Penetration Testing & VAPT', sub: 'OWASP & CERT-In methodology' },
                      { href: '/services/cloud-security-assessment', icon: '☁️', label: 'Cloud Security Assessment', sub: 'CSA CCM · AWS · Azure · GCP' },
                      { href: '/services/network-security-audit', icon: '🌐', label: 'Network Security Audit', sub: 'Perimeter · segmentation · wireless' },
                      { href: '/services/security-awareness-training', icon: '🎓', label: 'Security Awareness Training', sub: 'Phishing simulations · e-learning' },
                    ].map(item => (
                      <li>
                        <a href={item.href} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-red-50 transition-colors group/item" role="menuitem">
                          <span class="flex-shrink-0 w-8 h-8 rounded-md bg-red-50 flex items-center justify-center text-sm">{item.icon}</span>
                          <div>
                            <span class="font-medium text-sm text-[#111111] group-hover/item:text-[#DC2626] transition-colors block">{item.label}</span>
                            <span class="text-xs text-gray-400">{item.sub}</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Compliance -->
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider mb-3 flex items-center gap-2" style="color:#16A34A;">
                    <span class="w-5 h-5 rounded bg-green-100 flex items-center justify-center font-black text-xs" style="color:#16A34A;">C</span>
                    Compliance
                  </p>
                  <ul class="space-y-1">
                    {[
                      { href: '/services/dpdpa-compliance', icon: '🛡️', label: 'DPDPA 2023 Compliance', sub: "India's data protection law" },
                      { href: '/services/soc2-readiness', icon: '🔐', label: 'SOC 2 Readiness', sub: 'For Indian SaaS selling to US buyers' },
                      { href: '/services/iso-22301-bcm', icon: '🔄', label: 'ISO 22301 / BCM', sub: 'Business continuity & DR planning' },
                      { href: '/services/compliance-consulting', icon: '📋', label: 'Regulatory Compliance', sub: 'RBI · SEBI · PCI-DSS · CERT-In' },
                    ].map(item => (
                      <li>
                        <a href={item.href} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-green-50 transition-colors group/item" role="menuitem">
                          <span class="flex-shrink-0 w-8 h-8 rounded-md bg-green-50 flex items-center justify-center text-sm">{item.icon}</span>
                          <div>
                            <span class="font-medium text-sm text-[#111111] group-hover/item:text-[#16A34A] transition-colors block">{item.label}</span>
                            <span class="text-xs text-gray-400">{item.sub}</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>

                  <div class="mt-4 p-3 rounded-xl bg-amber-50">
                    <p class="text-xs font-semibold text-[#D97706] mb-1">New Service</p>
                    <a href="/services/ai-governance" class="text-xs font-bold text-[#111111] hover:text-[#DC2626] transition-colors">
                      AI Governance & ISO 42001 →
                    </a>
                    <p class="text-xs text-gray-500 mt-1">ISO/IEC 42001:2023 · AI risk for Indian enterprises</p>
                  </div>
                </div>
              </div>

              <div class="mt-5 pt-5 border-t border-gray-100 flex items-center justify-between">
                <p class="text-xs text-gray-400">ISO 27001 Lead Auditors · iValue Technology Partner · Bangalore, India</p>
                <a href="/services" class="text-xs font-semibold text-[#DC2626] hover:underline">View all services →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Industries -->
        <div class="relative group">
          <button class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium text-[#111111] hover:text-[#DC2626] hover:bg-red-50 transition-colors duration-150">
            Industries
            <svg class="w-4 h-4 opacity-60 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-56 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
            <div class="h-1 rounded-t-xl" style="background:#DC2626;"></div>
            <div class="bg-white rounded-b-xl shadow-xl border border-gray-100 py-2">
              {[
                { href: '/industries/financial-services', icon: '🏦', label: 'Banking & BFSI' },
                { href: '/industries/healthcare', icon: '🏥', label: 'Healthcare' },
                { href: '/industries/it-technology', icon: '💻', label: 'IT & SaaS' },
                { href: '/industries/manufacturing', icon: '🏭', label: 'Manufacturing' },
                { href: '/industries/retail', icon: '🛒', label: 'Retail & E-commerce' },
                { href: '/industries/education', icon: '🎓', label: 'Education' },
              ].map(item => (
                <a href={item.href} class="flex items-center gap-3 px-4 py-2.5 hover:bg-red-50 transition-colors text-sm text-[#111111] hover:text-[#DC2626]">
                  <span>{item.icon}</span>
                  <span class="font-medium">{item.label}</span>
                </a>
              ))}
              <div class="border-t border-gray-100 mt-1 pt-1">
                <a href="/industries" class="flex items-center gap-3 px-4 py-2.5 hover:bg-red-50 transition-colors text-sm font-semibold text-[#DC2626]">
                  View all industries →
                </a>
              </div>
            </div>
          </div>
        </div>

        <a href="/solutions" class="px-3 py-2 rounded-lg text-sm font-medium text-[#111111] hover:text-[#DC2626] hover:bg-red-50 transition-colors">Solutions</a>
        <a href="/blog" class="px-3 py-2 rounded-lg text-sm font-medium text-[#111111] hover:text-[#DC2626] hover:bg-red-50 transition-colors">Resources</a>
        <a href="/about" class="px-3 py-2 rounded-lg text-sm font-medium text-[#111111] hover:text-[#DC2626] hover:bg-red-50 transition-colors">About</a>
        <a href="/contact" class="px-3 py-2 rounded-lg text-sm font-medium text-[#111111] hover:text-[#DC2626] hover:bg-red-50 transition-colors">Contact</a>
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-white hover:opacity-90 transition-all" style="background:#DC2626;">
          Free GRC Consultation
        </a>
      </div>

      <!-- Mobile button -->
      <button id="mobile-menu-btn" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg text-[#111111] hover:bg-gray-100" aria-label="Toggle menu" aria-expanded="false">
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white">
    <div class="px-4 py-4 space-y-1">

      <!-- G accordion -->
      <div class="mobile-accordion">
        <button class="mobile-accordion-btn w-full flex items-center justify-between px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50" aria-expanded="false">
          <span class="flex items-center gap-2">
            <span class="w-5 h-5 rounded text-xs font-black text-white flex items-center justify-center" style="background:#D97706;">G</span>
            Governance
          </span>
          <svg class="accordion-chevron w-4 h-4 opacity-60 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="mobile-accordion-panel hidden pl-4 pb-2">
          {[
            { href: '/services/ai-governance', icon: '🤖', label: 'AI Governance & ISO 42001' },
            { href: '/services/vciso', icon: '👔', label: 'Virtual CISO (vCISO)' },
            { href: '/services/enterprise-risk', icon: '⚖️', label: 'Enterprise Risk Management' },
          ].map(item => (
            <a href={item.href} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-700 hover:text-[#D97706] hover:bg-amber-50">
              <span>{item.icon}</span><span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- S accordion -->
      <div class="mobile-accordion">
        <button class="mobile-accordion-btn w-full flex items-center justify-between px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50" aria-expanded="false">
          <span class="flex items-center gap-2">
            <span class="w-5 h-5 rounded text-xs font-black text-white flex items-center justify-center" style="background:#DC2626;">S</span>
            Security
          </span>
          <svg class="accordion-chevron w-4 h-4 opacity-60 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="mobile-accordion-panel hidden pl-4 pb-2">
          {[
            { href: '/services/iso-27001-consulting', icon: '🏆', label: 'ISO 27001 Consulting' },
            { href: '/services/gap-assessment', icon: '🔍', label: 'Gap Assessment' },
            { href: '/services/penetration-testing', icon: '🎯', label: 'Penetration Testing & VAPT' },
            { href: '/services/security-awareness-training', icon: '🎓', label: 'Security Awareness Training' },
          ].map(item => (
            <a href={item.href} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-700 hover:text-[#DC2626] hover:bg-red-50">
              <span>{item.icon}</span><span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- C accordion -->
      <div class="mobile-accordion">
        <button class="mobile-accordion-btn w-full flex items-center justify-between px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50" aria-expanded="false">
          <span class="flex items-center gap-2">
            <span class="w-5 h-5 rounded text-xs font-black text-white flex items-center justify-center" style="background:#16A34A;">C</span>
            Compliance
          </span>
          <svg class="accordion-chevron w-4 h-4 opacity-60 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="mobile-accordion-panel hidden pl-4 pb-2">
          {[
            { href: '/services/dpdpa-compliance', icon: '🛡️', label: 'DPDPA 2023 Compliance' },
            { href: '/services/soc2-readiness', icon: '🔐', label: 'SOC 2 Readiness' },
            { href: '/services/iso-22301-bcm', icon: '🔄', label: 'ISO 22301 / BCM' },
            { href: '/services/compliance-consulting', icon: '📋', label: 'Regulatory Compliance' },
          ].map(item => (
            <a href={item.href} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-700 hover:text-[#16A34A] hover:bg-green-50">
              <span>{item.icon}</span><span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <a href="/industries" class="block px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50">Industries</a>
      <a href="/solutions" class="block px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50">Solutions</a>
      <a href="/blog" class="block px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50">Resources</a>
      <a href="/about" class="block px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50">About</a>
      <a href="/contact" class="block px-3 py-3 rounded-lg text-sm font-semibold text-[#111111] hover:bg-gray-50">Contact</a>

      <div class="pt-2 pb-4">
        <a href="/contact" class="block w-full text-center px-5 py-3 rounded-xl text-sm font-semibold text-white" style="background:#DC2626;">
          Free GRC Consultation
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shadow-md', window.scrollY > 8);
  }, { passive: true });

  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu    = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon     = document.getElementById('close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
    mobileMenu?.classList.toggle('hidden', isOpen);
    hamburgerIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    mobileMenuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.mobile-accordion').forEach(accordion => {
    const btn    = accordion.querySelector('.mobile-accordion-btn');
    const panel  = accordion.querySelector('.mobile-accordion-panel');
    const chevron = accordion.querySelector('.accordion-chevron');
    btn?.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      panel?.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      chevron?.classList.toggle('rotate-180', !isOpen);
    });
  });
</script>
