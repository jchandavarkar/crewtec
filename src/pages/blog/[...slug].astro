---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blog');
const related = allPosts.filter(p => p.slug !== post.slug).slice(0, 2);

// Reading time estimate (~200 wpm)
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

function formatDate(date: Date) {
  return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}

const categoryColors: Record<string, { bg: string; text: string }> = {
  'Digital Growth': { bg: 'bg-[#00B4A0]/10', text: 'text-[#00B4A0]' },
  'Cybersecurity': { bg: 'bg-[#0099EE]/10', text: 'text-[#0099EE]' },
  'IT Solutions': { bg: 'bg-[#0099EE]/10', text: 'text-[#0099EE]' },
  'App Development': { bg: 'bg-[#6366F1]/10', text: 'text-[#6366F1]' },
  'SEO': { bg: 'bg-[#00B4A0]/10', text: 'text-[#00B4A0]' },
  'Web Development': { bg: 'bg-[#00B4A0]/10', text: 'text-[#00B4A0]' },
};

function getCategoryStyle(cat: string) {
  return categoryColors[cat] ?? { bg: 'bg-gray-100', text: 'text-gray-600' };
}

const catStyle = getCategoryStyle(post.data.category);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={`/blog/${post.slug}`}
>
  <Header />

  <!-- ── HERO ───────────────────────────────────────────────────── -->
  <section class="bg-[#0A1628] pt-24 pb-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 40px 40px;"></div>

    <div class="max-w-4xl mx-auto relative">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-white/40 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/70 transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white/70 transition-colors">Blog</a>
        <span>/</span>
        <span class="text-white/60 truncate max-w-xs">{post.data.title}</span>
      </nav>

      <!-- Category chip -->
      <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${catStyle.bg} ${catStyle.text} mb-6`}>
        {post.data.category}
      </span>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-6" style="font-family: 'Syne', sans-serif;">
        {post.data.title}
      </h1>

      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-white/50">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-[#0099EE] flex items-center justify-center text-white text-xs font-bold">
            {post.data.author.charAt(0)}
          </div>
          <span>{post.data.author}</span>
        </div>
        <span class="text-white/20">·</span>
        <span>{formatDate(post.data.pubDate)}</span>
        <span class="text-white/20">·</span>
        <span>{readingTime} min read</span>
      </div>
    </div>
  </section>

  <!-- ── TWO-COL BODY ───────────────────────────────────────────── -->
  <section class="bg-gray-50 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

        <!-- Left: Article content (2/3) -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 sm:p-10">
            <div class="blog-prose">
              <Content />
            </div>

            <!-- Tags -->
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-10 pt-8 border-t border-gray-100">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Tags</p>
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag: string) => (
                    <span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Right: Sidebar (1/3) -->
        <div class="space-y-6">

          <!-- Table of contents placeholder -->
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sticky top-24">
            <h3 class="text-sm font-bold text-[#0A1628] mb-4 uppercase tracking-wider" style="font-family: 'Syne', sans-serif;">
              In This Article
            </h3>
            <div id="toc-container">
              <p class="text-xs text-gray-400">Navigate to sections as you read.</p>
            </div>
          </div>

          <!-- CTA card -->
          <div class="bg-[#0A1628] rounded-2xl p-6 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 rounded-full opacity-10 blur-2xl" style="background: #0099EE;"></div>
            <p class="text-xs font-bold uppercase tracking-wider text-[#0099EE] mb-3">Need Help?</p>
            <h3 class="text-base font-bold mb-3 leading-snug" style="font-family: 'Syne', sans-serif;">
              Talk to a Crewtec Specialist
            </h3>
            <p class="text-xs text-white/60 leading-relaxed mb-5">
              Get personalised guidance on implementing strategies discussed in this article for your enterprise.
            </p>
            <a
              href="/contact"
              class="block text-center py-3 px-5 bg-[#0099EE] hover:bg-[#0077CC] text-white font-semibold rounded-xl text-sm transition-all duration-200 shadow-md"
            >
              Book Free Consultation
            </a>
          </div>

          <!-- Related posts -->
          {related.length > 0 && (
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 class="text-sm font-bold text-[#0A1628] mb-5 uppercase tracking-wider" style="font-family: 'Syne', sans-serif;">
                Related Articles
              </h3>
              <div class="space-y-5">
                {related.map(rp => {
                  const rs = getCategoryStyle(rp.data.category);
                  return (
                    <div class="group">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${rs.bg} ${rs.text} mb-1.5`}>
                        {rp.data.category}
                      </span>
                      <a
                        href={`/blog/${rp.slug}`}
                        class="block text-sm font-semibold text-[#0A1628] group-hover:text-[#0099EE] transition-colors leading-snug mb-1"
                        style="font-family: 'Syne', sans-serif;"
                      >
                        {rp.data.title}
                      </a>
                      <p class="text-xs text-gray-400">{formatDate(rp.data.pubDate)}</p>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>

      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
/* Manual prose styles for blog content (no @tailwindcss/typography needed) */
.blog-prose {
  color: #374151;
  font-size: 1rem;
  line-height: 1.8;
}
.blog-prose h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.6rem;
  font-weight: 700;
  color: #0A1628;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
  line-height: 1.3;
}
.blog-prose h3 {
  font-family: 'Syne', sans-serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #0A1628;
  margin-top: 2rem;
  margin-bottom: 0.75rem;
}
.blog-prose h4 {
  font-family: 'Syne', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: #0A1628;
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
}
.blog-prose p {
  margin-bottom: 1.25rem;
}
.blog-prose a {
  color: #0099EE;
  font-weight: 500;
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.15s;
}
.blog-prose a:hover {
  color: #0077CC;
}
.blog-prose strong {
  font-weight: 700;
  color: #0A1628;
}
.blog-prose em {
  font-style: italic;
}
.blog-prose ul,
.blog-prose ol {
  margin-bottom: 1.25rem;
  padding-left: 1.5rem;
}
.blog-prose ul {
  list-style-type: disc;
}
.blog-prose ol {
  list-style-type: decimal;
}
.blog-prose li {
  margin-bottom: 0.5rem;
}
.blog-prose blockquote {
  border-left: 4px solid #0099EE;
  padding-left: 1.25rem;
  margin: 1.5rem 0;
  color: #4B5563;
  font-style: italic;
}
.blog-prose code {
  background: #F3F4F6;
  border-radius: 4px;
  padding: 0.15em 0.4em;
  font-size: 0.875em;
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  color: #0A1628;
}
.blog-prose pre {
  background: #0A1628;
  color: #e5e7eb;
  border-radius: 12px;
  padding: 1.5rem;
  overflow-x: auto;
  margin: 1.5rem 0;
  font-size: 0.875rem;
}
.blog-prose pre code {
  background: none;
  padding: 0;
  color: inherit;
}
.blog-prose hr {
  border: none;
  border-top: 1px solid #E5E7EB;
  margin: 2rem 0;
}
.blog-prose table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 1.5rem;
  font-size: 0.9rem;
}
.blog-prose th {
  background: #F9FAFB;
  font-weight: 700;
  text-align: left;
  padding: 0.75rem 1rem;
  border-bottom: 2px solid #E5E7EB;
  color: #0A1628;
}
.blog-prose td {
  padding: 0.75rem 1rem;
  border-bottom: 1px solid #F3F4F6;
}
.blog-prose img {
  border-radius: 12px;
  max-width: 100%;
  margin: 1.5rem 0;
}
</style>

<script>
  // Build TOC from headings in the article
  const tocContainer = document.getElementById('toc-container');
  const headings = document.querySelectorAll('.blog-prose h2, .blog-prose h3');

  if (headings.length > 0 && tocContainer) {
    // Add IDs to headings
    headings.forEach((h, i) => {
      if (!h.id) {
        h.id = `section-${i}`;
      }
    });

    const tocList = document.createElement('nav');
    tocList.className = 'space-y-1.5';
    tocList.setAttribute('aria-label', 'Table of contents');

    headings.forEach((h) => {
      const link = document.createElement('a');
      link.href = `#${h.id}`;
      link.textContent = h.textContent ?? '';
      link.className = h.tagName === 'H2'
        ? 'block text-xs font-semibold text-[#0A1628] hover:text-[#0099EE] transition-colors py-0.5 truncate'
        : 'block text-xs text-gray-500 hover:text-[#0099EE] transition-colors pl-3 py-0.5 border-l border-gray-100 truncate';

      link.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById(h.id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      tocList.appendChild(link);
    });

    tocContainer.innerHTML = '';
    tocContainer.appendChild(tocList);
  }
</script>
