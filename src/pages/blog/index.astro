---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.find(p => p.data.featured);
const rest = posts.filter(p => !p.data.featured);

const categoryColors: Record<string, { bg: string; text: string }> = {
  'Digital Growth': { bg: 'bg-[#00B4A0]/10', text: 'text-[#00B4A0]' },
  'Cybersecurity': { bg: 'bg-[#0099EE]/10', text: 'text-[#0099EE]' },
  'IT Solutions': { bg: 'bg-[#0099EE]/10', text: 'text-[#0099EE]' },
  'App Development': { bg: 'bg-[#6366F1]/10', text: 'text-[#6366F1]' },
  'SEO': { bg: 'bg-[#00B4A0]/10', text: 'text-[#00B4A0]' },
  'Web Development': { bg: 'bg-[#00B4A0]/10', text: 'text-[#00B4A0]' },
};

function getCategoryStyle(cat: string) {
  return categoryColors[cat] ?? { bg: 'bg-gray-100', text: 'text-gray-600' };
}

function formatDate(date: Date) {
  return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="Enterprise Technology Blog | Crewtec Insights"
  description="Expert insights on enterprise cybersecurity, website development, SEO strategies, and application development from Crewtec's team."
  canonical="/blog"
>
  <Header />

  <!-- ── 1. HERO ─────────────────────────────────────────────────── -->
  <section class="bg-[#0A1628] pt-24 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #00B4A0, transparent);"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold bg-[#00B4A0]/20 text-[#00B4A0] border border-[#00B4A0]/30 uppercase tracking-wider mb-8">
        Insights & Guides
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6" style="font-family: 'Syne', sans-serif;">
        Enterprise Technology Insights
      </h1>
      <p class="text-lg sm:text-xl text-white/70 max-w-2xl mx-auto">
        Expert guides on cybersecurity, web development, SEO, and app development for Indian enterprises.
      </p>
    </div>
  </section>

  <!-- ── 2. FEATURED POST ───────────────────────────────────────── -->
  {featured && (
    <section class="bg-white py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-2 mb-8">
          <div class="w-1 h-5 rounded-full bg-[#0099EE]"></div>
          <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Featured Article</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center bg-gray-50 rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-200">
          <!-- Image placeholder -->
          <div class="bg-gradient-to-br from-[#0A1628] to-[#0099EE]/80 h-72 lg:h-full min-h-[300px] flex items-center justify-center">
            <div class="text-center px-8">
              <div class="text-6xl mb-4">📘</div>
              <p class="text-white/60 text-sm">Featured Article</p>
            </div>
          </div>

          <!-- Content -->
          <div class="p-10">
            {(() => {
              const style = getCategoryStyle(featured.data.category);
              return (
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${style.bg} ${style.text} mb-5`}>
                  {featured.data.category}
                </span>
              );
            })()}

            <h2 class="text-2xl sm:text-3xl font-bold text-[#0A1628] mb-4 leading-tight" style="font-family: 'Syne', sans-serif;">
              {featured.data.title}
            </h2>
            <p class="text-gray-600 leading-relaxed mb-6 text-sm">
              {featured.data.description}
            </p>

            <div class="flex items-center gap-4 text-xs text-gray-400 mb-8">
              <span>{featured.data.author}</span>
              <span>·</span>
              <span>{formatDate(featured.data.pubDate)}</span>
            </div>

            <a
              href={`/blog/${featured.slug}`}
              class="inline-flex items-center gap-2 px-6 py-3 bg-[#0099EE] hover:bg-[#0077CC] text-white font-semibold rounded-xl text-sm transition-all duration-200 shadow-sm hover:shadow hover:-translate-y-0.5"
            >
              Read Article
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── 3. ALL POSTS GRID ──────────────────────────────────────── -->
  <section class="bg-gray-50 py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 mb-10">
        <div class="w-1 h-5 rounded-full bg-[#00B4A0]"></div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">All Articles</p>
      </div>

      {rest.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {rest.map(post => {
            const style = getCategoryStyle(post.data.category);
            return (
              <article class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden group flex flex-col">
                <!-- Placeholder image area -->
                <div class="h-44 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                  <span class="text-4xl opacity-40">📄</span>
                </div>

                <div class="p-6 flex flex-col flex-1">
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${style.bg} ${style.text} mb-3 w-fit`}>
                    {post.data.category}
                  </span>

                  <h3 class="text-base font-bold text-[#0A1628] mb-3 leading-snug group-hover:text-[#0099EE] transition-colors" style="font-family: 'Syne', sans-serif;">
                    {post.data.title}
                  </h3>

                  <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1">
                    {post.data.description}
                  </p>

                  <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-50">
                    <div class="text-xs text-gray-400">
                      <span>{post.data.author}</span>
                      <span class="mx-1">·</span>
                      <span>{formatDate(post.data.pubDate)}</span>
                    </div>
                    <a
                      href={`/blog/${post.slug}`}
                      class="inline-flex items-center gap-1 text-xs font-semibold text-[#0099EE] hover:gap-2 transition-all duration-200"
                    >
                      Read
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16 text-gray-400">
          <p class="text-lg">More articles coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ── 4. NEWSLETTER CTA ──────────────────────────────────────── -->
  <section class="bg-[#0A1628] py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 40px 40px;"></div>

    <div class="max-w-2xl mx-auto relative text-center">
      <h2 class="text-3xl font-extrabold text-white mb-4" style="font-family: 'Syne', sans-serif;">
        Stay Updated
      </h2>
      <p class="text-white/60 mb-8 text-lg">
        Get expert enterprise technology insights delivered to your inbox — no spam, just actionable guides.
      </p>

      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="return false;">
        <input
          type="email"
          placeholder="your@company.com"
          class="flex-1 px-5 py-3.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#0099EE] focus:bg-white/15 transition-colors"
        />
        <button
          type="submit"
          class="px-6 py-3.5 bg-[#0099EE] hover:bg-[#0077CC] text-white font-semibold rounded-xl text-sm transition-all duration-200 whitespace-nowrap shadow-md hover:shadow-lg"
        >
          Subscribe
        </button>
      </form>

      <p class="text-xs text-white/30 mt-4">No spam. Unsubscribe at any time.</p>
    </div>
  </section>

  <Footer />
</BaseLayout>
