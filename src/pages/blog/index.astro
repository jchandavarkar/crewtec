---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.find(p => p.data.featured);
const rest = posts.filter(p => !p.data.featured);

const categoryColors: Record<string, { bg: string; text: string }> = {
  'Cybersecurity': { bg: 'bg-red-100', text: 'text-red-600' },
  'ISO 27001': { bg: 'bg-red-100', text: 'text-red-600' },
  'Compliance': { bg: 'bg-green-100', text: 'text-green-700' },
  'VAPT': { bg: 'bg-red-100', text: 'text-red-600' },
  'vCISO': { bg: 'bg-amber-100', text: 'text-amber-700' },
  'Security Awareness': { bg: 'bg-amber-100', text: 'text-amber-700' },
  'Incident Response': { bg: 'bg-red-100', text: 'text-red-600' },
  'Risk Management': { bg: 'bg-amber-100', text: 'text-amber-700' },
};

function getCategoryStyle(cat: string) {
  return categoryColors[cat] ?? { bg: 'bg-gray-100', text: 'text-gray-600' };
}

function formatDate(date: Date) {
  return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="GRC & Cybersecurity Insights | Crewtec Blog"
  description="Expert guides on ISO 27001, DPDPA 2023, VAPT, vCISO, and enterprise cybersecurity for Indian enterprises. From Crewtec's GRC consultants in Bangalore."
  canonical="/blog"
>
  <Header />

  <!-- ── 1. HERO ─────────────────────────────────────────────────── -->
  <section class="pt-24 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden" style="background:#0A0A0A;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #DC2626, transparent);"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider mb-8" style="background:rgba(220,38,38,0.12);color:#DC2626;border:1px solid rgba(220,38,38,0.2);">
        Insights & Guides
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6" style="font-family: 'Rajdhani', sans-serif;">
        GRC & Cybersecurity Insights
      </h1>
      <p class="text-lg sm:text-xl text-white/70 max-w-2xl mx-auto">
        Practical guides on ISO 27001, DPDPA, VAPT, and compliance — written for Indian enterprises by GRC consultants.
      </p>
    </div>
  </section>

  <!-- ── 2. FEATURED POST ───────────────────────────────────────── -->
  {featured && (
    <section class="bg-white py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-2 mb-8">
          <div class="w-1 h-5 rounded-full bg-[#DC2626]"></div>
          <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Featured Article</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center bg-gray-50 rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-200">
          <!-- Image placeholder -->
          <div class="h-72 lg:h-full min-h-[300px] flex items-center justify-center" style="background:linear-gradient(135deg,#0A0A0A 0%,rgba(220,38,38,0.6) 100%);">
            <div class="text-center px-8">
              <div class="text-6xl mb-4">📘</div>
              <p class="text-white/60 text-sm">Featured Article</p>
            </div>
          </div>

          <!-- Content -->
          <div class="p-10">
            {(() => {
              const style = getCategoryStyle(featured.data.category);
              return (
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${style.bg} ${style.text} mb-5`}>
                  {featured.data.category}
                </span>
              );
            })()}

            <h2 class="text-2xl sm:text-3xl font-bold mb-4 leading-tight" style="font-family: 'Rajdhani', sans-serif;color:#111111;">
              {featured.data.title}
            </h2>
            <p class="text-gray-600 leading-relaxed mb-6 text-sm">
              {featured.data.description}
            </p>

            <div class="flex items-center gap-4 text-xs text-gray-400 mb-8">
              <span>{featured.data.author}</span>
              <span>·</span>
              <span>{formatDate(featured.data.pubDate)}</span>
            </div>

            <a
              href={`/blog/${featured.slug}`}
              class="inline-flex items-center gap-2 px-6 py-3 text-white font-semibold rounded-xl text-sm transition-all duration-200 shadow-sm hover:opacity-90 hover:-translate-y-0.5"
              style="background:#DC2626;"
            >
              Read Article
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── 3. ALL POSTS GRID ──────────────────────────────────────── -->
  <section style="background:#F5F5F5;" class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 mb-10">
        <div class="w-1 h-5 rounded-full bg-[#DC2626]"></div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">All Articles</p>
      </div>

      {rest.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {rest.map(post => {
            const style = getCategoryStyle(post.data.category);
            return (
              <article class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden group flex flex-col">
                <!-- Placeholder image area -->
                <div class="h-44 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                  <span class="text-4xl opacity-40">📄</span>
                </div>

                <div class="p-6 flex flex-col flex-1">
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${style.bg} ${style.text} mb-3 w-fit`}>
                    {post.data.category}
                  </span>

                  <h3 class="text-base font-bold mb-3 leading-snug group-hover:text-[#DC2626] transition-colors" style="font-family: 'Rajdhani', sans-serif;color:#111111;">
                    {post.data.title}
                  </h3>

                  <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1">
                    {post.data.description}
                  </p>

                  <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-50">
                    <div class="text-xs text-gray-400">
                      <span>{post.data.author}</span>
                      <span class="mx-1">·</span>
                      <span>{formatDate(post.data.pubDate)}</span>
                    </div>
                    <a
                      href={`/blog/${post.slug}`}
                      class="inline-flex items-center gap-1 text-xs font-semibold text-[#DC2626] hover:gap-2 transition-all duration-200"
                    >
                      Read
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16 text-gray-400">
          <p class="text-lg">More articles coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ── 4. CTA ──────────────────────────────────────────────────── -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden" style="background:#0A0A0A;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 40px 40px;"></div>

    <div class="max-w-2xl mx-auto relative text-center">
      <h2 class="text-3xl font-extrabold text-white mb-4" style="font-family: 'Rajdhani', sans-serif;">
        Need a GRC Consultation?
      </h2>
      <p class="text-white/60 mb-8 text-lg">
        30 minutes with an ISO 27001 Lead Auditor — free, no obligation. Get an honest assessment of your security posture.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-semibold text-white hover:opacity-90 transition-all shadow-md"
        style="background:#DC2626;"
      >
        Book Free Consultation →
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
