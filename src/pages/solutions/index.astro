---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { solutions, grcSolutionMap } from '../../data/solutions.js';

// Build a lookup of solution id → full solution object
const solutionById = Object.fromEntries(solutions.map(s => [s.id, s]));

const pillarConfig = [
  { id: 'Security',   color: '#DC2626', bg: '#FFF1F1', label: 'S', tagline: 'Technology that fixes red findings' },
  { id: 'Governance', color: '#D97706', bg: '#FFFBEB', label: 'G', tagline: 'Technology that enforces accountability' },
  { id: 'Compliance', color: '#16A34A', bg: '#F0FDF4', label: 'C', tagline: 'Technology that achieves green status' },
];
---

<BaseLayout
  title="Cybersecurity Technology Solutions | iValue Partner | Crewtec Bangalore"
  description="Crewtec deploys cybersecurity technology from iValue's vendor ecosystem — SentinelOne, Palo Alto, CyberArk, Thales, Splunk and more. We find what's red. iValue technology fixes it."
  canonical="/solutions"
>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden pt-24 pb-20" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image:radial-gradient(rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;"></div>
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none opacity-15" style="background:radial-gradient(ellipse at 80% 20%,#DC2626 0%,transparent 60%);"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6" style="background:rgba(220,38,38,0.12);color:#DC2626;">
        iValue Technology Partner
      </span>
      <h1 class="text-5xl font-bold text-white mb-6 leading-tight" style="font-family:'Rajdhani',sans-serif;">
        We Find What's Red.<br/>Here's the Technology That Fixes It.
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-10">
        Every Crewtec assessment surfaces red findings — vulnerabilities, control gaps, compliance failures. As an authorised iValue Technology partner, we don't just report the problem. We deploy the solution.
      </p>

      <!-- RAG flow strip -->
      <div class="inline-flex items-center gap-0 rounded-2xl overflow-hidden border border-white/10 text-sm font-semibold">
        <div class="flex items-center gap-3 px-6 py-4" style="background:rgba(220,38,38,0.2);">
          <span class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-black text-white" style="background:#DC2626;">1</span>
          <span class="text-white">Crewtec finds RED</span>
        </div>
        <div class="px-4 text-white/30 text-lg">→</div>
        <div class="flex items-center gap-3 px-6 py-4" style="background:rgba(217,119,6,0.2);">
          <span class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-black text-white" style="background:#D97706;">2</span>
          <span class="text-white">iValue technology fixes it</span>
        </div>
        <div class="px-4 text-white/30 text-lg">→</div>
        <div class="flex items-center gap-3 px-6 py-4" style="background:rgba(22,163,74,0.2);">
          <span class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-black text-white" style="background:#16A34A;">3</span>
          <span class="text-white">You turn GREEN</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky pillar nav -->
  <div class="sticky top-16 z-40 bg-white border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 flex gap-8 overflow-x-auto no-scrollbar">
      {pillarConfig.map(p => (
        <a href={`#pillar-${p.id.toLowerCase()}`} class="flex-shrink-0 flex items-center gap-2 py-4 text-sm font-semibold border-b-2 transition-colors" style={`border-color:${p.color};color:${p.color};`}>
          <span class="w-5 h-5 rounded flex items-center justify-center text-xs font-black text-white" style={`background:${p.color};`}>{p.label}</span>
          {p.id}
        </a>
      ))}
    </div>
  </div>

  <!-- Solution pillars -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 space-y-24">

      {pillarConfig.map(pillar => {
        const cats = grcSolutionMap[pillar.id] || [];
        return (
          <div id={`pillar-${pillar.id.toLowerCase()}`} class="scroll-mt-32">

            <!-- Pillar header -->
            <div class="flex items-start gap-5 mb-12 pb-6 border-b-2" style={`border-color:${pillar.color}30;`}>
              <div class="w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center font-black text-xl text-white" style={`background:${pillar.color};`}>
                {pillar.label}
              </div>
              <div>
                <h2 class="text-3xl font-bold mb-1" style={`font-family:'Rajdhani',sans-serif;color:${pillar.color};`}>
                  {pillar.id}
                </h2>
                <p class="text-gray-500">{pillar.tagline}</p>
              </div>
            </div>

            <!-- Solution categories -->
            <div class="space-y-10">
              {cats.map(cat => {
                const sol = solutionById[cat.id];
                if (!sol) return null;
                const brands = sol.brands || [];
                return (
                  <div class="rounded-2xl border border-gray-100 overflow-hidden">
                    <!-- Category header: the RED finding -->
                    <div class="p-6 border-b border-gray-100" style={`background:${pillar.bg};`}>
                      <div class="flex items-start gap-4">
                        <span class="text-2xl flex-shrink-0">{cat.icon}</span>
                        <div class="flex-1">
                          <div class="flex flex-wrap items-center gap-3 mb-2">
                            <h3 class="text-lg font-bold" style={`font-family:'Rajdhani',sans-serif;color:#111111;`}>
                              {cat.label}
                            </h3>
                            <span class="text-xs px-2.5 py-1 rounded-full font-semibold" style="background:#DC262615;color:#DC2626;">
                              🔴 Common finding
                            </span>
                          </div>
                          <p class="text-sm text-gray-600 italic">"{cat.redFinding}"</p>
                        </div>
                        <a href={`/solutions/${cat.id}`} class="flex-shrink-0 text-sm font-semibold hidden sm:block" style={`color:${pillar.color};`}>
                          All vendors →
                        </a>
                      </div>
                    </div>

                    <!-- Vendor cards -->
                    <div class="p-6">
                      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                        {brands.slice(0, 4).map(brand => (
                          <div class="p-4 rounded-xl border border-gray-100 hover:border-gray-200 hover:shadow-sm transition-all bg-white">
                            <div class="flex items-start justify-between gap-2 mb-2">
                              <p class="font-bold text-sm text-[#111111]" style="font-family:'Rajdhani',sans-serif;">{brand.name}</p>
                              <span class="text-xs px-2 py-0.5 rounded-md flex-shrink-0 whitespace-nowrap" style={`background:${pillar.color}12;color:${pillar.color};`}>
                                {brand.type.split(' ').slice(0, 2).join(' ')}
                              </span>
                            </div>
                            <p class="text-xs text-gray-500 leading-relaxed line-clamp-3">{brand.overview.split('.')[0]}.</p>
                          </div>
                        ))}
                        {brands.length > 4 && (
                          <a href={`/solutions/${cat.id}`} class="p-4 rounded-xl border border-dashed border-gray-200 hover:border-gray-400 transition-all flex items-center justify-center text-sm font-semibold text-gray-400 hover:text-gray-600">
                            +{brands.length - 4} more →
                          </a>
                        )}
                      </div>

                      <!-- Fix CTA -->
                      <div class="mt-5 pt-5 border-t border-gray-100 flex flex-wrap items-center justify-between gap-4">
                        <p class="text-xs text-gray-500">
                          Crewtec assesses your exposure, recommends the right vendor, and handles deployment.
                        </p>
                        <a href="/contact" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white hover:opacity-90 transition-all" style={`background:${pillar.color};`}>
                          Fix this finding →
                        </a>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- iValue credential -->
  <section class="py-20" style="background:#F5F5F5;">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="w-10 h-10 rounded-xl flex items-center justify-center font-black text-white text-lg" style="background:#D97706;">i</span>
        <span class="text-lg font-bold text-[#111111]" style="font-family:'Rajdhani',sans-serif;">iValue Technology Partner</span>
      </div>
      <h2 class="text-3xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#111111;">
        Why iValue? Why Crewtec?
      </h2>
      <p class="text-gray-600 mb-10 max-w-2xl mx-auto">
        iValue is India's leading value-added distributor for enterprise cybersecurity — representing 50+ global vendors. Crewtec, as an authorised iValue partner, brings the combination of GRC advisory and technology deployment that most consultants lack.
      </p>
      <div class="grid sm:grid-cols-3 gap-6 text-left">
        {[
          { icon: '🔎', title: 'We find the gap', body: 'Crewtec assessments identify exactly which controls are missing, which CVEs are exploitable, and which compliance obligations are unmet.' },
          { icon: '🛠️', title: 'We deploy the fix', body: 'As an iValue partner, we procure and deploy the right technology — no vendor lock-in, no product-first recommendations.' },
          { icon: '✅', title: 'We certify the outcome', body: 'We then guide you through ISO 27001, DPDPA, or SOC 2 — using the deployed technology as evidence for your audit trail.' },
        ].map(v => (
          <div class="bg-white p-6 rounded-2xl border border-gray-100">
            <div class="text-3xl mb-4">{v.icon}</div>
            <h3 class="font-bold mb-2" style="font-family:'Rajdhani',sans-serif;color:#111111;">{v.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background:#0A0A0A;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Start With the Assessment — Not the Product
      </h2>
      <p class="text-gray-300 mb-8">
        Book a free 30-minute GRC consultation. We identify your red findings first, then recommend the right technology to fix them — no vendor bias, no overselling.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all" style="background:#DC2626;">
          Book Free Assessment →
        </a>
        <a href="/services" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-gray-900 transition-all duration-200">
          View GRC Services
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
