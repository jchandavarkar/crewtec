---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { solutions, grcSolutionMap, serviceSolutionMap } from '../../data/solutions.js';
import { cyberServices } from '../../data/cyberServices.js';

export function getStaticPaths() {
  return solutions.map(s => ({ params: { id: s.id }, props: { sol: s } }));
}

const { sol } = Astro.props;

const pillarColors = { Security: '#DC2626', Governance: '#D97706', Compliance: '#16A34A' };
const pillarBgs   = { Security: '#FFF1F1', Governance: '#FFFBEB', Compliance: '#F0FDF4' };

let pillar: string | null = null;
let redFinding: string | null = null;
let pillarCatLabel: string | null = null;

for (const [p, cats] of Object.entries(grcSolutionMap)) {
  const cat = (cats as any[]).find((c: any) => c.id === sol.id);
  if (cat) { pillar = p; redFinding = cat.redFinding; pillarCatLabel = cat.label; break; }
}

const color  = pillar ? pillarColors[pillar as keyof typeof pillarColors] : '#DC2626';
const catBg  = pillar ? pillarBgs[pillar as keyof typeof pillarBgs]       : '#FFF1F1';

const relatedServices = cyberServices
  .filter((svc: any) => (serviceSolutionMap[svc.id as keyof typeof serviceSolutionMap] || []).includes(sol.id))
  .slice(0, 3);

const svcPillarColors: Record<string, string> = { Governance: '#D97706', Security: '#DC2626', Compliance: '#16A34A' };

const otherSols = solutions.filter((s: any) => s.id !== sol.id).slice(0, 4);
---

<BaseLayout
  title={`${sol.name} | iValue Technology Solutions | Crewtec Bangalore`}
  description={sol.metaDesc || sol.fullDesc}
  canonical={`/solutions/${sol.id}`}
>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden pt-24 pb-20" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image:radial-gradient(rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;"></div>
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style={`background:radial-gradient(ellipse at 80% 20%,${color}30 0%,transparent 60%);`}></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6 text-sm">
            <a href="/solutions" class="text-gray-400 hover:text-white transition-colors">Solutions</a>
            <span class="text-gray-600">/</span>
            {pillar && <span class="font-medium" style={`color:${color};`}>{pillar}</span>}
            {pillar && <span class="text-gray-600">/</span>}
            <span class="text-white">{sol.name}</span>
          </div>

          <div class="flex items-center gap-3 mb-5">
            <span class="text-4xl">{sol.icon}</span>
            {pillar && (
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold" style={`background:${color}25;color:${color};`}>
                {pillar} · iValue Partner
              </span>
            )}
          </div>

          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 leading-tight" style="font-family:'Rajdhani',sans-serif;">
            {sol.name}
          </h1>
          <p class="text-gray-300 leading-relaxed mb-8">{sol.fullDesc}</p>

          <div class="flex flex-wrap gap-4">
            <a href="/contact" class="inline-flex items-center gap-2 px-7 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all hover:-translate-y-0.5 shadow-lg" style={`background:${color};`}>
              Book Free Assessment →
            </a>
            <a href="/solutions" class="inline-flex items-center gap-2 px-7 py-4 rounded-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-gray-900 transition-all duration-200">
              All Solutions
            </a>
          </div>
        </div>

        <div class="space-y-4">
          {redFinding && (
            <div class="rounded-2xl border p-6" style="background:rgba(220,38,38,0.08);border-color:rgba(220,38,38,0.2);">
              <div class="flex items-start gap-3">
                <span class="text-xl flex-shrink-0">🔴</span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-red-400 mb-2">Common red finding this fixes</p>
                  <p class="text-white/80 text-sm italic">"{redFinding}"</p>
                </div>
              </div>
            </div>
          )}
          <div class="rounded-2xl border p-6" style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);">
            <p class="text-xs font-semibold uppercase tracking-wider mb-4" style={`color:${color};`}>
              {sol.brands?.length} vendors available through iValue
            </p>
            <div class="flex flex-wrap gap-2">
              {(sol.brands || []).map((b: any) => (
                <span class="text-xs px-2.5 py-1 rounded-full text-white/60 border border-white/10">{b.name}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vendor cards -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-14">
        <p class="text-xs font-semibold uppercase tracking-wider mb-2" style={`color:${color};`}>iValue Technology Partner</p>
        <h2 class="text-4xl font-bold mb-3" style="font-family:'Rajdhani',sans-serif;color:#111111;">
          Vendors We Deploy for {sol.name}
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Crewtec assesses your exposure, selects the right vendor for your risk profile, and handles deployment and configuration — no vendor bias.
        </p>
      </div>

      <div class="space-y-6">
        {(sol.brands || []).map((brand: any) => (
          <div class="rounded-2xl border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
            <div class="p-6 border-b border-gray-50" style={`background:${catBg};`}>
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <div>
                    <h3 class="text-lg font-bold" style={`font-family:'Rajdhani',sans-serif;color:#111111;`}>{brand.name}</h3>
                    <span class="text-xs px-2.5 py-1 rounded-full font-semibold inline-block mt-1" style={`background:${color}15;color:${color};`}>
                      {brand.type}
                    </span>
                  </div>
                </div>
                <a href="/contact" class="text-sm font-semibold hover:underline flex-shrink-0" style={`color:${color};`}>
                  Ask about {brand.name} →
                </a>
              </div>
            </div>

            <div class="p-6">
              <p class="text-gray-600 text-sm leading-relaxed mb-6">{brand.overview}</p>

              <div class="grid sm:grid-cols-3 gap-6">
                {brand.features?.length > 0 && (
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wider mb-3 text-gray-400">Key features</p>
                    <ul class="space-y-1.5">
                      {brand.features.map((f: string) => (
                        <li class="flex items-start gap-2 text-xs text-gray-600">
                          <svg class="w-3.5 h-3.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style={`color:${color};`}>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                          </svg>
                          {f}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {brand.useCases?.length > 0 && (
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wider mb-3 text-gray-400">Use cases</p>
                    <ul class="space-y-1.5">
                      {brand.useCases.map((u: string) => (
                        <li class="flex items-start gap-2 text-xs text-gray-600">
                          <span class="flex-shrink-0 mt-0.5 text-xs" style={`color:${color};`}>→</span>
                          {u}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {brand.whyCrewtec && (
                  <div class="rounded-xl p-4" style={`background:${color}08;border:1px solid ${color}20;`}>
                    <p class="text-xs font-bold uppercase tracking-wider mb-2" style={`color:${color};`}>Why Crewtec</p>
                    <p class="text-xs text-gray-600 leading-relaxed">{brand.whyCrewtec}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related GRC services -->
  {relatedServices.length > 0 && (
    <section class="py-20" style="background:#F5F5F5;">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="mb-10">
          <p class="text-xs font-semibold uppercase tracking-wider mb-2" style={`color:${color};`}>Linked GRC services</p>
          <h2 class="text-3xl font-bold" style="font-family:'Rajdhani',sans-serif;color:#111111;">
            Crewtec services that surface these findings
          </h2>
          <p class="text-gray-600 mt-2">We find the red. We deploy the fix. We certify the green.</p>
        </div>
        <div class="grid sm:grid-cols-3 gap-6">
          {relatedServices.map((svc: any) => {
            const c = svcPillarColors[svc.pillar] || '#DC2626';
            return (
              <a href={`/services/${svc.id}`} class="group p-6 rounded-2xl border border-gray-200 hover:border-gray-300 hover:shadow-md transition-all bg-white flex flex-col">
                <div class="text-2xl mb-3">{svc.icon}</div>
                <p class="text-xs font-semibold uppercase tracking-wider mb-1" style={`color:${c};`}>{svc.pillar}</p>
                <h3 class="text-sm font-bold mb-2 group-hover:text-[#DC2626] transition-colors" style="font-family:'Rajdhani',sans-serif;color:#111111;">{svc.name}</h3>
                <p class="text-xs text-gray-500 leading-relaxed flex-1 mb-3">{svc.shortDesc}</p>
                <span class="text-sm font-semibold" style={`color:${c};`}>Learn More →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- More solutions -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <h2 class="text-2xl font-bold mb-8" style="font-family:'Rajdhani',sans-serif;color:#111111;">
        More technology solutions
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {otherSols.map((s: any) => (
          <a href={`/solutions/${s.id}`} class="group p-5 rounded-2xl border border-gray-100 hover:border-gray-300 hover:shadow-md transition-all bg-white flex flex-col">
            <span class="text-2xl mb-3">{s.icon}</span>
            <h3 class="text-sm font-bold mb-1 group-hover:text-[#DC2626] transition-colors" style="font-family:'Rajdhani',sans-serif;color:#111111;">{s.name}</h3>
            <p class="text-xs text-gray-500 leading-relaxed flex-1">{s.shortDesc}</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/solutions" class="inline-flex items-center gap-2 text-sm font-semibold hover:underline" style="color:#DC2626;">
          View all solutions →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background:#0A0A0A;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Not sure which vendor is right for you?
      </h2>
      <p class="text-gray-300 mb-8">
        Book a free 30-minute assessment. Crewtec evaluates your environment first — then recommends the right technology. No vendor bias, no overselling.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all" style={`background:${color};`}>
          Book Free Assessment →
        </a>
        <a href="/solutions" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-gray-900 transition-all duration-200">
          All Solutions
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
