---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { industries } from '../../data/industries.js';
---

<BaseLayout
  title="Cybersecurity by Industry | ISO 27001 & Compliance Consulting India | Crewtec"
  description="Crewtec delivers industry-specific cybersecurity consulting — ISO 27001, VAPT, compliance, and vCISO services for BFSI, healthcare, IT, manufacturing, and more."
  canonical="/industries"
>
  <Header />

  <!-- Hero -->
  <section class="py-24 relative overflow-hidden" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6" style="background:rgba(220,38,38,0.12);color:#DC2626;">
        Industry Expertise
      </span>
      <h1 class="text-5xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Cybersecurity Consulting Across Every Major Indian Industry
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Compliance requirements, threat landscapes, and risk priorities differ by industry. We understand the nuances — from RBI norms for BFSI to DISHA for healthcare.
      </p>
    </div>
  </section>

  <!-- Industries grid -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map(ind => (
          <a
            href={`/industries/${ind.id}`}
            class="group p-7 rounded-2xl border border-gray-100 hover:border-gray-300 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col bg-white"
          >
            <div class="flex items-center gap-4 mb-5">
              <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl flex-shrink-0" style={`background:${ind.color}15;`}>
                {ind.icon}
              </div>
              <div>
                <h2 class="text-lg font-bold leading-tight group-hover:text-[#DC2626] transition-colors" style="font-family:'Rajdhani',sans-serif;color:#111111;">
                  {ind.name}
                </h2>
                <p class="text-xs text-gray-400 mt-0.5">{ind.tagline}</p>
              </div>
            </div>

            <p class="text-gray-600 text-sm leading-relaxed flex-1 mb-5">{ind.shortDesc}</p>

            <div class="border-t border-gray-100 pt-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Key Regulations</p>
              <div class="flex flex-wrap gap-2">
                {ind.regulations.slice(0, 3).map(reg => (
                  <span class="text-xs px-2 py-1 rounded-md" style={`background:${ind.color}12;color:${ind.color};`}>{reg.split(' ').slice(0, 2).join(' ')}</span>
                ))}
              </div>
            </div>

            <div class="mt-4 text-sm font-semibold" style="color:#DC2626;">
              View {ind.shortName || ind.name} Security Guide →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background:#0A0A0A;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Don't See Your Industry?
      </h2>
      <p class="text-gray-300 mb-8">
        We work across all sectors. Contact us for a conversation about your specific compliance and security requirements.
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity" style="background:#DC2626;">
        Book Free Assessment →
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
