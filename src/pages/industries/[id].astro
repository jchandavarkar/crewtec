---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { industries } from '../../data/industries.js';
import { cyberServices } from '../../data/cyberServices.js';

export async function getStaticPaths() {
  return industries.map(ind => ({ params: { id: ind.id }, props: { industry: ind } }));
}

const { industry: ind } = Astro.props;
const relevantServices = cyberServices.filter(s => ind.keyServices.includes(s.id));
const otherIndustries = industries.filter(i => i.id !== ind.id).slice(0, 4);
const pillarColors: Record<string, string> = { Governance: '#D97706', Security: '#DC2626', Compliance: '#16A34A' };
---

<BaseLayout
  title={ind.metaTitle}
  description={ind.metaDesc}
  canonical={`/industries/${ind.id}`}
>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden pt-24 pb-20" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style={`background: radial-gradient(ellipse at 80% 20%, ${ind.color}30 0%, transparent 60%);`}></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <a href="/industries" class="text-gray-400 hover:text-white text-sm transition-colors">Industries</a>
            <span class="text-gray-600">/</span>
            <span class="text-sm font-medium text-white">{ind.name}</span>
          </div>

          <div class="flex items-center gap-3 mb-5">
            <span class="text-4xl">{ind.icon}</span>
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold" style={`background:${ind.color}30;color:${ind.color};`}>
              Industry Guide
            </span>
          </div>

          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-5 leading-tight" style="font-family:'Rajdhani',sans-serif;">
            Cybersecurity for {ind.name}
          </h1>
          <p class="text-lg text-gray-300 mb-8">{ind.heroDesc}</p>

          <a href="/contact" class="inline-flex items-center gap-2 px-7 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all hover:-translate-y-0.5 shadow-lg" style="background:#DC2626;">
            Get {ind.name} Security Assessment →
          </a>
        </div>

        <!-- Regulations + Stats -->
        <div class="space-y-5">
          <div class="rounded-2xl border p-6" style="background:rgba(255,255,255,0.05); border-color:rgba(255,255,255,0.1);">
            <h2 class="text-sm font-semibold uppercase tracking-wider mb-4" style={`color:${ind.color};`}>
              Applicable Regulations & Frameworks
            </h2>
            <div class="flex flex-wrap gap-2">
              {ind.regulations.map(reg => (
                <span class="text-xs px-3 py-1.5 rounded-full border text-white/70" style="border-color:rgba(255,255,255,0.15);">{reg}</span>
              ))}
            </div>
          </div>

          {ind.stats && ind.stats.length > 0 && (
            <div class="grid grid-cols-2 gap-4">
              {ind.stats.map(s => (
                <div class="p-5 rounded-2xl text-center" style="background:rgba(255,255,255,0.06);">
                  <p class="text-2xl font-bold text-white mb-1" style={`font-family:'Rajdhani',sans-serif;color:${ind.color};`}>{s.value}</p>
                  <p class="text-xs text-gray-400">{s.label}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Security Challenges -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-bold mb-3" style="font-family:'Rajdhani',sans-serif;color:#111111;">
          Key Security Challenges in {ind.name}
        </h2>
        <p class="text-gray-600 max-w-xl mx-auto">
          Industry-specific threats and compliance gaps that our consultants see repeatedly.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {ind.securityChallenges.map(challenge => (
          <div class="p-7 rounded-2xl border border-gray-100 hover:shadow-md transition-shadow bg-white">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style={`background:${ind.color}15;`}>
              <svg class="w-5 h-5" fill="none" stroke={ind.color} viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
            </div>
            <h3 class="text-base font-bold mb-2" style="font-family:'Rajdhani',sans-serif;color:#111111;">{challenge.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{challenge.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recommended Services -->
  {relevantServices.length > 0 && (
    <section class="py-24" style="background:#F5F5F5;">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="text-center mb-14">
          <h2 class="text-4xl font-bold mb-3" style="font-family:'Rajdhani',sans-serif;color:#111111;">
            Recommended Services for {ind.name}
          </h2>
          <p class="text-gray-600 max-w-xl mx-auto">
            Services we typically deploy for {ind.name} organisations, based on regulatory requirements and risk profile.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relevantServices.map(svc => {
            const c = pillarColors[svc.pillar] || svc.color;
            return (
              <a href={`/services/${svc.id}`} class="group p-7 rounded-2xl border border-gray-200 hover:border-gray-300 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col bg-white">
                <div class="text-3xl mb-4">{svc.icon}</div>
                <p class="text-xs font-semibold uppercase tracking-wider mb-2" style={`color:${c};`}>{svc.pillar}</p>
                <h3 class="text-lg font-bold mb-2 group-hover:text-[#DC2626] transition-colors" style="font-family:'Rajdhani',sans-serif;color:#111111;">{svc.name}</h3>
                <p class="text-gray-500 text-sm leading-relaxed flex-1 mb-4">{svc.shortDesc}</p>
                <span class="text-sm font-semibold" style={`color:${c};`}>Learn More →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Case Study -->
  {ind.caseStudy && (
    <section class="py-24 bg-white">
      <div class="max-w-4xl mx-auto px-6">
        <div class="rounded-2xl p-10 border-l-4 border-[#DC2626] bg-red-50">
          <p class="text-xs font-semibold uppercase tracking-wider text-[#DC2626] mb-3">Client Success Story</p>
          <h3 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#111111;">{ind.caseStudy.title}</h3>
          <p class="text-gray-600 leading-relaxed mb-4">{ind.caseStudy.desc}</p>
          <div class="inline-flex items-center gap-3 px-5 py-3 rounded-xl" style="background:rgba(220,38,38,0.1);">
            <svg class="w-5 h-5 text-[#DC2626]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="font-semibold text-[#DC2626] text-sm">{ind.caseStudy.result}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Other industries -->
  <section class="py-20" style="background:#F5F5F5;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <h2 class="text-2xl font-bold mb-8" style="font-family:'Rajdhani',sans-serif;color:#111111;">
        Other Industries We Serve
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {otherIndustries.map(i => (
          <a href={`/industries/${i.id}`} class="group p-5 rounded-2xl border border-gray-100 hover:border-gray-300 hover:shadow-md transition-all bg-white flex items-center gap-4">
            <span class="text-2xl flex-shrink-0">{i.icon}</span>
            <div>
              <span class="font-semibold text-sm text-[#111111] group-hover:text-[#DC2626] transition-colors block">{i.name}</span>
              <span class="text-xs text-gray-400">{i.tagline}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background:#0A0A0A;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Ready to Secure Your {ind.name} Organisation?
      </h2>
      <p class="text-gray-300 mb-8">
        Book a free 30-minute assessment with one of our industry specialists — no obligation, no sales pitch.
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity" style="background:#DC2626;">
        Book Free Assessment →
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
