---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Book Free Security Assessment | Contact Crewtec Cybersecurity Bangalore"
  description="Book a free cybersecurity assessment with Crewtec. ISO 27001 consulting, vCISO, VAPT, and compliance consulting for Indian enterprises. Bangalore, India."
  canonical="/contact"
>
  <Header />

  <!-- Hero -->
  <section class="py-20" style="background:#0A0A0A;">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-5" style="background:rgba(220,38,38,0.12);color:#DC2626;">
        Free Consultation — No Obligation
      </span>
      <h1 class="text-5xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Book Your Free Security Assessment
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        30 minutes with an ISO 27001 Lead Auditor. Walk away with a clear picture of your security posture and what it will cost to fix it.
      </p>
    </div>
  </section>

  <!-- Form + Info -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-5 gap-14">

        <!-- Contact Info (left) -->
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="text-2xl font-bold mb-3" style="font-family:'Rajdhani',sans-serif;color:#111111;">
              Get in Touch
            </h2>
            <p class="text-gray-600 text-sm leading-relaxed">
              Contact us by phone, email, or WhatsApp — or fill the form and we will respond within 4 business hours.
            </p>
          </div>

          <div class="space-y-5">
            <a href="tel:+919986437648" class="flex items-center gap-4 p-5 rounded-2xl border border-gray-100 hover:border-red-200 hover:shadow-md transition-all group">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#F5F5F5;">
                <svg class="w-5 h-5" fill="none" stroke="#DC2626" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-400 mb-0.5">Call us</p>
                <p class="font-semibold text-[#111111] group-hover:text-[#DC2626] transition-colors">+91 99864 37648</p>
              </div>
            </a>

            <a href="mailto:sales@crewtec.in" class="flex items-center gap-4 p-5 rounded-2xl border border-gray-100 hover:border-red-200 hover:shadow-md transition-all group">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#F5F5F5;">
                <svg class="w-5 h-5" fill="none" stroke="#DC2626" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-400 mb-0.5">Email us</p>
                <p class="font-semibold text-[#111111] group-hover:text-[#DC2626] transition-colors">sales@crewtec.in</p>
              </div>
            </a>

            <a href="https://wa.me/919986437648" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 rounded-2xl border border-gray-100 hover:border-green-200 hover:shadow-md transition-all group">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#25D36615;">
                <svg class="w-5 h-5" fill="#25D366" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-400 mb-0.5">WhatsApp</p>
                <p class="font-semibold text-[#111111] group-hover:text-green-600 transition-colors">+91 99864 37648</p>
              </div>
            </a>

            <div class="flex items-start gap-4 p-5 rounded-2xl border border-gray-100 bg-gray-50">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#F5F5F5;">
                <svg class="w-5 h-5" fill="none" stroke="#DC2626" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-400 mb-0.5">Office</p>
                <p class="text-sm font-medium text-[#111111]">No. 10/11, Maragondanahalli Tavarekere,<br />Bangalore – 562130</p>
              </div>
            </div>
          </div>

          <div class="p-5 rounded-2xl" style="background:#F5F5F5; border:1px solid #E5E5E5;">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#111111] mb-2">Emergency Incident Response</p>
            <p class="text-sm text-gray-600 mb-2">Experiencing a security breach? Call us immediately — 2-hour SLA for active incidents.</p>
            <a href="tel:+919986437648" class="text-sm font-bold text-red-600 hover:text-red-700">+91 99864 37648 (24/7)</a>
          </div>
        </div>

        <!-- Form (right) -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8">
            <h2 class="text-2xl font-bold mb-2" style="font-family:'Rajdhani',sans-serif;color:#111111;">
              Request a Free Assessment
            </h2>
            <p class="text-gray-500 text-sm mb-8">We respond within 4 business hours.</p>

            <form
              name="cybersecurity-assessment"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              action="/thank-you"
              class="space-y-5"
            >
              <input type="hidden" name="form-name" value="cybersecurity-assessment" />
              <p class="hidden">
                <label>Don't fill this out: <input name="bot-field" /></label>
              </p>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="fname" class="block text-sm font-semibold text-gray-700 mb-1.5">First Name <span class="text-red-500">*</span></label>
                  <input
                    type="text" id="fname" name="first_name" required
                    placeholder="Rajesh"
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                    style="focus:ring-color:#DC2626;"
                  />
                </div>
                <div>
                  <label for="lname" class="block text-sm font-semibold text-gray-700 mb-1.5">Last Name <span class="text-red-500">*</span></label>
                  <input
                    type="text" id="lname" name="last_name" required
                    placeholder="Kumar"
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Business Email <span class="text-red-500">*</span></label>
                <input
                  type="email" id="email" name="email" required
                  placeholder="rajesh@company.com"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                />
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1.5">Phone <span class="text-red-500">*</span></label>
                  <input
                    type="tel" id="phone" name="phone" required
                    placeholder="+91 98XXXXXXXX"
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-semibold text-gray-700 mb-1.5">Company Name <span class="text-red-500">*</span></label>
                  <input
                    type="text" id="company" name="company" required
                    placeholder="Acme Pvt Ltd"
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                  />
                </div>
              </div>

              <div>
                <label for="service" class="block text-sm font-semibold text-gray-700 mb-1.5">Service Interested In</label>
                <select
                  id="service" name="service"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                >
                  <option value="">Select a service...</option>
                  <optgroup label="Governance">
                    <option value="AI Governance (ISO 42001)">AI Governance (ISO 42001)</option>
                    <option value="Virtual CISO (vCISO)">Virtual CISO (vCISO)</option>
                    <option value="Enterprise Risk Management">Enterprise Risk Management</option>
                  </optgroup>
                  <optgroup label="Security">
                    <option value="ISO 27001 Consulting">ISO 27001 Consulting</option>
                    <option value="Cybersecurity Gap Assessment">Cybersecurity Gap Assessment</option>
                    <option value="Penetration Testing / VAPT">Penetration Testing / VAPT</option>
                    <option value="Security Awareness Training">Security Awareness Training</option>
                  </optgroup>
                  <optgroup label="Compliance">
                    <option value="DPDPA 2023 Compliance">DPDPA 2023 Compliance</option>
                    <option value="SOC 2 Readiness">SOC 2 Readiness</option>
                    <option value="ISO 22301 Business Continuity">ISO 22301 Business Continuity</option>
                    <option value="Regulatory Compliance (RBI/SEBI/PCI-DSS)">Regulatory Compliance (RBI/SEBI/PCI-DSS)</option>
                  </optgroup>
                  <option value="Not Sure / General Enquiry">Not Sure / General Enquiry</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-semibold text-gray-700 mb-1.5">Tell us about your requirement</label>
                <textarea
                  id="message" name="message" rows="4"
                  placeholder="e.g. We are a 300-person NBFC looking to get ISO 27001 certified before the next RBI audit in Q3..."
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:border-transparent transition-all resize-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-4 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-90 hover:-translate-y-0.5 shadow-md"
                style="background:#DC2626;"
              >
                Book Free Security Assessment →
              </button>

              <p class="text-xs text-gray-400 text-center">
                We respect your privacy. Your details are never shared with third parties.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  input:focus, textarea:focus, select:focus {
    ring-color: #DC2626;
    border-color: #DC2626;
    box-shadow: 0 0 0 3px rgba(220,38,38,0.15);
  }
</style>
