---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About Crewtec | GRC & Cybersecurity Consultants Bangalore India"
  description="Crewtec is a Bangalore-based GRC and cybersecurity consultancy, est. 2021. Certified ISO 27001 Lead Auditors, iValue Technology partner — helping Indian enterprises achieve certification and compliance."
  canonical="/about"
>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden pt-24 pb-20" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image:radial-gradient(rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;"></div>
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none opacity-20" style="background:radial-gradient(ellipse at 80% 20%,#DC2626 0%,transparent 60%);"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6" style="background:rgba(220,38,38,0.12);color:#DC2626;">
        About Crewtec
      </span>
      <h1 class="text-5xl font-bold text-white mb-6" style="font-family:'Rajdhani',sans-serif;">
        Who Is Behind Crewtec's Governance, Security &amp; Compliance Practice?
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        A Bangalore-based GRC consultancy, founded in 2021 — built specifically for the regulatory reality facing Indian enterprises today.
      </p>
    </div>
  </section>

  <!-- Mission & Story -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="text-4xl font-bold mb-6" style="font-family:'Rajdhani',sans-serif;color:#111111;">
            Why We Started — and Why It Still Matters
          </h2>
          <div class="space-y-5 text-gray-600 leading-relaxed">
            <p>
              Crewtec was founded in 2021 in Bangalore with a simple belief: Governance, Security, and Compliance should be accessible to every Indian enterprise — not just multinationals with large security budgets.
            </p>
            <p>
              We are not a software company that added "consulting" to its service menu. We are GRC consultants first and always — certified ISO 27001 Lead Auditors and iValue Technology Group's authorised partner for security deployments in India.
            </p>
            <p>
              Our team has deep experience across ISO 27001, ISO 42001 (AI Governance), DPDPA 2023, RBI Cyber Security Framework, SEBI CSCRF, and VAPT. We work with clients ranging from 50-person SaaS startups preparing for enterprise sales to mid-size manufacturing groups managing ICS/OT risk.
            </p>
            <p>
              What they have in common: they chose Crewtec because they needed an expert who speaks their language, understands Indian regulation, and gives them honest advice — not a vendor trying to sell the largest retainer.
            </p>
          </div>
        </div>

        <div class="space-y-5">
          <div class="grid grid-cols-2 gap-5">
            {[
              { v: '2021', l: 'Est. in Bangalore' },
              { v: '11', l: 'GRC Services' },
              { v: '10+', l: 'Regulatory Frameworks' },
              { v: '12+', l: 'Industry Verticals' },
            ].map(s => (
              <div class="p-6 rounded-2xl border border-gray-100 bg-gray-50 text-center">
                <p class="text-3xl font-bold mb-1" style="font-family:'Rajdhani',sans-serif;color:#DC2626;">{s.v}</p>
                <p class="text-sm text-gray-500">{s.l}</p>
              </div>
            ))}
          </div>

          <div class="p-6 rounded-2xl border border-amber-100 bg-amber-50">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#D97706] mb-2">New: AI Governance</p>
            <p class="text-sm font-bold text-[#111111] mb-1">ISO/IEC 42001:2023 — AI Management Systems</p>
            <p class="text-sm text-gray-600">
              Crewtec is among the few Indian consultancies offering structured ISO 42001 AI Governance programmes. Published in December 2023, this standard is already being demanded by enterprise procurement and financial regulators.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-green-100 bg-green-50">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#16A34A] mb-2">Partner Credential</p>
            <p class="text-sm font-bold text-[#111111] mb-1">iValue Technology Group — Authorised Partner</p>
            <p class="text-sm text-gray-600">
              Crewtec is an authorised partner of iValue, India's leading value-added distributor for cybersecurity technology — giving our clients access to best-in-class security platforms alongside our advisory and audit services.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="py-24" style="background:#F5F5F5;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#111111;">
          What Credentials Does Crewtec Hold?
        </h2>
        <p class="text-gray-600 max-w-xl mx-auto">
          Certifications that regulators and enterprise procurement teams recognise.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: '🏆',
            title: 'ISO 27001 Lead Auditors',
            desc: 'Our senior consultants are certified ISO 27001 Lead Auditors and Lead Implementers — not just practitioners who have read the standard. We conduct gap assessments, Stage 1 and Stage 2 audit support, and ongoing ISMS maintenance.',
          },
          {
            icon: '🔒',
            title: 'VAPT & Security Testing',
            desc: "Crewtec's penetration testing follows OWASP, PTES, and CERT-In published guidelines for information security audit. Our reports are structured with CVSS-scored findings, executive summaries, and step-by-step remediation guidance.",
          },
          {
            icon: '🤖',
            title: 'ISO 42001 AI Governance',
            desc: 'ISO/IEC 42001:2023 is the first international standard for AI Management Systems. Published December 2023, it is already being demanded by enterprise buyers and regulators. Crewtec helps organisations design and audit compliant AI governance frameworks.',
          },
          {
            icon: '📋',
            title: 'Multi-Framework Expertise',
            desc: 'ISO 27001 · ISO 42001 · NIST CSF · NIST AI RMF · CIS Controls · PCI-DSS v4.0 · DPDPA 2023 · RBI Cyber Security Framework · SEBI CSCRF · CERT-In guidelines.',
          },
          {
            icon: '🏭',
            title: '12+ Industry Verticals',
            desc: 'BFSI / NBFC · Healthcare & Hospitals · IT Services & SaaS · Manufacturing & ICS · Retail & E-commerce · Education & EdTech · Logistics · Real Estate · Construction · Solar & Renewable Energy.',
          },
          {
            icon: '🤝',
            title: 'iValue Technology Partner',
            desc: "Authorised partner of iValue Technology Group — India's leading cybersecurity value-added distributor. This gives our clients access to best-in-class security platforms alongside our advisory and audit services.",
          },
        ].map(c => (
          <div class="bg-white p-7 rounded-2xl border border-gray-100 hover:shadow-md transition-shadow">
            <div class="text-3xl mb-4">{c.icon}</div>
            <h3 class="text-lg font-bold mb-3" style="font-family:'Rajdhani',sans-serif;color:#111111;">{c.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-4xl font-bold mb-6" style="font-family:'Rajdhani',sans-serif;color:#111111;">
            How Does Crewtec Work With Clients?
          </h2>
          <div class="space-y-6">
            {[
              {
                n: '01',
                title: 'Honest, not aspirational',
                desc: 'We tell you what you need — not what you want to hear. If you are not ready for ISO 27001 certification in 12 weeks, we say so and explain why. If you need a control we recommend against buying, we say that too.',
              },
              {
                n: '02',
                title: 'Fixed price, not open-ended billing',
                desc: 'We quote a fixed price after the initial gap assessment. You know what you will pay before you sign — no billable-hour surprises, no scope creep discussions mid-engagement.',
              },
              {
                n: '03',
                title: 'Knowledge transfer, not dependency',
                desc: "Our goal is to leave your team more capable than we found it. We document everything, train your staff, and structure engagements so you can maintain your ISMS without us.",
              },
              {
                n: '04',
                title: 'India-first, not template-driven',
                desc: "We do not take a Western cybersecurity framework and retrofit it to India. We understand CERT-In, DPDPA 2023, RBI's IT Act obligations, and what Indian auditors actually check.",
              },
            ].map(v => (
              <div class="flex gap-5">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center text-sm font-bold text-white" style="background:#DC2626;font-family:'Rajdhani',sans-serif;">{v.n}</div>
                <div>
                  <h3 class="font-bold text-[#111111] mb-1">{v.title}</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">{v.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden border border-gray-100 shadow-sm bg-gray-50 p-8">
          <p class="text-lg font-semibold text-[#111111] mb-5" style="font-family:'Rajdhani',sans-serif;">
            What We Cover
          </p>
          <div class="space-y-4">
            {[
              { label: 'Regulatory Frameworks Supported', value: '10+', pct: 100 },
              { label: 'Industry Verticals Served', value: '12+', pct: 80 },
              { label: 'Average Weeks to ISO 27001 Certification', value: '14 wks', pct: 60 },
              { label: 'GRC Services Available', value: '11', pct: 55 },
            ].map(m => (
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-sm text-gray-700">{m.label}</span>
                  <span class="text-sm font-bold text-[#111111]">{m.value}</span>
                </div>
                <div class="h-2 rounded-full bg-gray-200 overflow-hidden">
                  <div class="h-full rounded-full" style={`background:#DC2626;width:${m.pct}%;`}></div>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-6 pt-6 border-t border-gray-200">
            <div class="flex flex-wrap gap-2">
              {['ISO 27001 Lead Auditors', 'iValue Partner', 'Est. 2021 · Bangalore'].map(tag => (
                <span class="text-xs px-3 py-1.5 rounded-full bg-white border border-gray-200 text-gray-600">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background:#0A0A0A;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Talk to a GRC Expert
      </h2>
      <p class="text-gray-300 mb-8">
        30-minute free consultation. No obligation. We will review your current posture across Governance, Security, and Compliance — and give you an honest recommendation.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all" style="background:#DC2626;">
          Book Free Consultation →
        </a>
        <a href="https://wa.me/919986437648" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-gray-900 transition-all duration-200">
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
