---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { cyberServices } from '../../data/cyberServices.js';
import { solutions, serviceSolutionMap } from '../../data/solutions.js';

export function getStaticPaths() {
  return cyberServices.map(svc => ({ params: { id: svc.id }, props: { svc } }));
}

const { svc } = Astro.props;
const otherServices = cyberServices.filter(s => s.id !== svc.id).slice(0, 3);
const pillarColors = { Governance: '#D97706', Security: '#DC2626', Compliance: '#16A34A' };
const color = pillarColors[svc.pillar] || svc.color;

// Technology solutions relevant to this service
const relevantSolIds = serviceSolutionMap[svc.id] || [];
const relevantSols = relevantSolIds
  .map(id => solutions.find(s => s.id === id))
  .filter(Boolean)
  .slice(0, 4);
---

<BaseLayout title={svc.metaTitle} description={svc.metaDesc} canonical={`/services/${svc.id}`}>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden pt-24 pb-20" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image:radial-gradient(rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;"></div>
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style={`background:radial-gradient(ellipse at 80% 20%,${color}30 0%,transparent 60%);`}></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <!-- Breadcrumb -->
          <div class="flex items-center gap-3 mb-6 text-sm">
            <a href="/services" class="text-gray-400 hover:text-white transition-colors">Services</a>
            <span class="text-gray-600">/</span>
            <span class="font-medium" style={`color:${color};`}>{svc.pillar}</span>
            <span class="text-gray-600">/</span>
            <span class="text-white">{svc.shortName}</span>
          </div>

          <div class="flex items-center gap-3 mb-5">
            <span class="text-4xl">{svc.icon}</span>
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold" style={`background:${color}30;color:${color};`}>
              {svc.pillar}
            </span>
          </div>

          <!-- H1 is the question -->
          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 leading-tight" style="font-family:'Rajdhani',sans-serif;">
            {svc.question}
          </h1>
          <p class="text-base italic mb-5" style={`color:${color};`}>{svc.tagline}</p>
          <p class="text-gray-300 leading-relaxed mb-8">{svc.heroDesc}</p>

          <div class="flex flex-wrap gap-4">
            <a href="/contact" class="inline-flex items-center gap-2 px-7 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all hover:-translate-y-0.5 shadow-lg" style={`background:${color};`}>
              Book Free Consultation →
            </a>
            <a href="https://wa.me/919986437648" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-7 py-4 rounded-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-gray-900 transition-all duration-200">
              WhatsApp Us
            </a>
          </div>
        </div>

        <!-- Why Now / Benefits -->
        <div class="rounded-2xl border p-7" style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);">
          <h2 class="text-sm font-semibold uppercase tracking-wider mb-5" style={`color:${color};`}>
            Why does this matter now?
          </h2>
          <ul class="space-y-3">
            {(svc.whyNow || svc.benefits || []).map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style={`color:${color};`}>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="text-gray-200 text-sm leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-6 pt-6 border-t border-white/10">
            <div class="flex flex-wrap gap-3">
              {['ISO 27001 Lead Auditors', 'iValue Technology Partner', 'Est. 2021 · Bangalore'].map(tag => (
                <span class="text-xs px-3 py-1.5 rounded-full border border-white/20 text-white/60">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-bold mb-3" style="font-family:'Rajdhani',sans-serif;color:#111111;">
          How does the {svc.shortName} engagement work?
        </h2>
        <p class="text-gray-600">A structured process — so you always know what is happening and what comes next.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
        {svc.process.map((step, idx) => (
          <div class="relative p-6 rounded-2xl border border-gray-100 hover:shadow-md transition-shadow bg-white">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center text-sm font-bold text-white mb-4" style={`background:${color};font-family:'Rajdhani',sans-serif;`}>
              {step.step}
            </div>
            <h3 class="text-sm font-bold mb-2" style="font-family:'Rajdhani',sans-serif;color:#111111;">{step.title}</h3>
            <p class="text-gray-500 text-xs leading-relaxed">{step.desc}</p>
            {idx < svc.process.length - 1 && (
              <div class="hidden xl:block absolute top-8 -right-3 text-gray-300 text-sm font-bold">→</div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technology we deploy -->
  {relevantSols.length > 0 && (
    <section class="py-16 border-t border-gray-100 bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider mb-1" style={`color:${color};`}>iValue Technology Partner</p>
            <h2 class="text-2xl font-bold" style="font-family:'Rajdhani',sans-serif;color:#111111;">
              Technology We Deploy to Fix These Findings
            </h2>
          </div>
          <a href="/solutions" class="text-sm font-semibold hover:underline" style={`color:${color};`}>
            View all solutions →
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relevantSols.map(sol => {
            const topBrand = sol.brands?.[0];
            return (
              <a href={`/solutions/${sol.id}`} class="group p-5 rounded-2xl border border-gray-100 hover:border-gray-300 hover:shadow-md transition-all bg-white flex flex-col">
                <span class="text-2xl mb-3">{sol.icon}</span>
                <h3 class="text-sm font-bold mb-1 group-hover:text-[#DC2626] transition-colors" style="font-family:'Rajdhani',sans-serif;color:#111111;">
                  {sol.name}
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed flex-1 mb-3">{sol.shortDesc}</p>
                {topBrand && (
                  <p class="text-xs font-semibold" style={`color:${color};`}>
                    {sol.brands.slice(0, 3).map(b => b.name).join(' · ')}
                  </p>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- FAQs -->
  {svc.faqs && svc.faqs.length > 0 && (
    <section class="py-24" style="background:#F5F5F5;">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold mb-3" style="font-family:'Rajdhani',sans-serif;color:#111111;">
            Questions about {svc.name}
          </h2>
        </div>
        <div class="space-y-3">
          {svc.faqs.map((faq, i) => (
            <div class="border border-gray-200 rounded-2xl overflow-hidden bg-white">
              <button
                class="w-full flex items-center justify-between px-6 py-5 text-left hover:bg-gray-50 transition-colors faq-btn"
                aria-expanded="false"
              >
                <span class="text-sm font-semibold text-[#111111] pr-4">{faq.q}</span>
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="hidden px-6 pb-5 faq-panel">
                <p class="text-sm text-gray-600 leading-relaxed">{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Services -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <h2 class="text-3xl font-bold mb-10" style="font-family:'Rajdhani',sans-serif;color:#111111;">
        What other services does Crewtec offer?
      </h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {otherServices.map(s => {
          const c = pillarColors[s.pillar] || s.color;
          return (
            <a href={`/services/${s.id}`} class="group p-6 rounded-2xl border border-gray-100 hover:border-gray-200 hover:shadow-md transition-all duration-200 flex flex-col bg-white hover:-translate-y-1">
              <div class="text-2xl mb-3">{s.icon}</div>
              <p class="text-xs font-semibold uppercase tracking-wider mb-1" style={`color:${c};`}>{s.pillar}</p>
              <h3 class="text-sm font-bold mb-2 group-hover:text-[#DC2626] transition-colors leading-snug" style="font-family:'Rajdhani',sans-serif;color:#111111;">{s.question}</h3>
              <p class="text-gray-500 text-xs leading-relaxed flex-1 mb-3">{s.shortDesc}</p>
              <span class="text-sm font-semibold" style={`color:${c};`}>Learn More →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 relative overflow-hidden" style="background:#0A0A0A;">
    <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Ready to talk about {svc.shortName}?
      </h2>
      <p class="text-gray-300 mb-8">
        Book a free 30-minute consultation — no obligation. We will review your situation and give you an honest recommendation.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all" style={`background:${color};`}>
          Book Free Consultation →
        </a>
        <a href="https://wa.me/919986437648" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-gray-900 transition-all duration-200">
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      const panel = btn.nextElementSibling;
      const icon  = btn.querySelector('.faq-icon');
      panel?.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      icon?.classList.toggle('rotate-180', !isOpen);
    });
  });
</script>
