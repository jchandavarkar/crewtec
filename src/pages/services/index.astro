---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { cyberServices, pillars } from '../../data/cyberServices.js';

const pillarColors = { Governance: '#D97706', Security: '#DC2626', Compliance: '#16A34A' };

const grouped = pillars.map(p => ({
  ...p,
  color: pillarColors[p.label] || p.color,
  items: cyberServices.filter(s => s.pillar === p.label),
}));
---

<BaseLayout
  title="GRC & Cybersecurity Services India | Governance, Security, Compliance | Crewtec"
  description="Governance, Security & Compliance services for Indian enterprises — ISO 27001, AI Governance (ISO 42001), DPDPA, vCISO, VAPT, and regulatory compliance. Bangalore-based."
  canonical="/services"
>
  <Header />

  <!-- Hero -->
  <section class="py-24 relative overflow-hidden" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image:radial-gradient(rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center font-black text-sm text-white" style="background:#D97706;">G</span>
        <span class="text-white/40 font-light text-2xl">·</span>
        <span class="w-8 h-8 rounded-lg flex items-center justify-center font-black text-sm text-white" style="background:#DC2626;">S</span>
        <span class="text-white/40 font-light text-2xl">·</span>
        <span class="w-8 h-8 rounded-lg flex items-center justify-center font-black text-sm text-white" style="background:#16A34A;">C</span>
      </div>
      <h1 class="text-5xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        What GRC Services Does Your Organisation Need?
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        11 services across Governance, Security &amp; Compliance — each designed to give Indian enterprises a measurable improvement in risk posture and regulatory standing.
      </p>
    </div>
  </section>

  <!-- Pillar nav -->
  <div class="sticky top-16 z-40 bg-white border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 flex gap-8 overflow-x-auto no-scrollbar">
      {grouped.map(g => (
        <a href={`#pillar-${g.id}`} class="flex-shrink-0 flex items-center gap-2 py-4 text-sm font-semibold border-b-2 transition-colors hover:text-[#DC2626]" style={`border-color:${g.color};color:${g.color};`}>
          <span class="w-5 h-5 rounded flex items-center justify-center text-xs font-black text-white" style={`background:${g.color};`}>{g.label[0]}</span>
          {g.label}
        </a>
      ))}
    </div>
  </div>

  <!-- Services grouped by pillar -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 space-y-20">
      {grouped.map(group => (
        <div id={`pillar-${group.id}`} class="scroll-mt-32">
          <!-- Pillar header -->
          <div class="flex items-start gap-5 mb-10 pb-6 border-b-2" style={`border-color:${group.color}30;`}>
            <div class="w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center font-black text-xl text-white" style={`background:${group.color};`}>
              {group.label[0]}
            </div>
            <div>
              <h2 class="text-3xl font-bold mb-1" style={`font-family:'Rajdhani',sans-serif;color:${group.color};`}>{group.label}</h2>
              <p class="text-gray-500 leading-relaxed max-w-2xl">{group.question}</p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.items.map(svc => (
              <a
                href={`/services/${svc.id}`}
                class="group p-7 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col bg-white"
                style={`--hover-border:${group.color}40;`}
              >
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl flex-shrink-0" style={`background:${group.color}18;`}>
                    {svc.icon}
                  </div>
                  <p class="text-xs font-semibold uppercase tracking-wider" style={`color:${group.color};`}>{svc.pillar}</p>
                </div>

                <h3 class="text-lg font-bold mb-2 leading-snug transition-colors group-hover:text-[#DC2626]" style="font-family:'Rajdhani',sans-serif;color:#111111;">
                  {svc.question}
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed flex-1 mb-5">{svc.shortDesc}</p>

                <div class="flex items-center justify-between border-t border-gray-100 pt-4">
                  <div class="flex gap-2 flex-wrap">
                    {(svc.whyNow || svc.benefits || []).slice(0, 1).map(b => (
                      <span class="text-xs px-2.5 py-1 rounded-full" style={`background:${group.color}12;color:${group.color};`}>
                        {b.split(' ').slice(0, 4).join(' ')}…
                      </span>
                    ))}
                  </div>
                  <span class="text-sm font-semibold flex-shrink-0" style={`color:${group.color};`}>Explore →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Why GRC -->
  <section class="py-24" style="background:#F5F5F5;">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold mb-5" style="font-family:'Rajdhani',sans-serif;color:#111111;">
        Why Do Indian Enterprises Need All Three — G, S &amp; C?
      </h2>
      <p class="text-gray-600 text-lg mb-12 max-w-3xl mx-auto">
        Governance without Security is policy on paper. Security without Compliance creates regulatory exposure. Compliance without Governance drifts without accountability. All three must work together.
      </p>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { letter: 'G', color: '#D97706', bg: '#FFFBEB', title: 'Governance', body: 'Assigns accountability, sets risk appetite, and gives the board visibility into security posture. Without governance, Security and Compliance have no mandate.', href: '#pillar-governance' },
          { letter: 'S', color: '#DC2626', bg: '#FFF1F1', title: 'Security', body: 'Technical and operational controls that actually protect data. Without real security, certifications and policies are hollow — and attackers know it.', href: '#pillar-security' },
          { letter: 'C', color: '#16A34A', bg: '#F0FDF4', title: 'Compliance', body: 'Demonstrates to regulators, customers, and partners that controls are in place and auditable. Mandatory for BFSI, healthcare, and enterprise vendor lists.', href: '#pillar-compliance' },
        ].map(p => (
          <a href={p.href} class="p-7 rounded-2xl hover:shadow-md transition-all text-left" style={`background:${p.bg};`}>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center font-black text-2xl text-white mb-4" style={`background:${p.color};`}>{p.letter}</div>
            <h3 class="text-xl font-bold mb-2" style={`font-family:'Rajdhani',sans-serif;color:${p.color};`}>{p.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{p.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24" style="background:#0A0A0A;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-5" style="font-family:'Rajdhani',sans-serif;">
        Not Sure Which Service You Need?
      </h2>
      <p class="text-gray-300 mb-8">
        Start with a free 30-minute GRC consultation. We will review your current posture, identify gaps across Governance, Security, and Compliance, and recommend a prioritised roadmap — no obligation.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white hover:opacity-90 transition-all" style="background:#DC2626;">
          Book Free GRC Consultation →
        </a>
        <a href="https://wa.me/919986437648" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-gray-900 transition-all duration-200">
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
