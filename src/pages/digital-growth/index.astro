---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { digitalGrowthServices, digitalGrowthMeta } from '../../data/digitalGrowth.js';

const industries = [
  { id: 'manufacturing', name: 'Manufacturing', icon: '🏭', note: 'B2B portals, dealer networks & plant websites' },
  { id: 'healthcare', name: 'Healthcare', icon: '🏥', note: 'Patient acquisition, local SEO & health portals' },
  { id: 'real-estate', name: 'Real Estate', icon: '🏢', note: 'Lead gen sites, property SEO & paid campaigns' },
  { id: 'financial-services', name: 'Financial Services', icon: '💼', note: 'Trust-building content, compliance-safe ads' },
  { id: 'education', name: 'Education', icon: '🎓', note: 'Admissions funnels, SEO & Meta lead campaigns' },
  { id: 'it-technology', name: 'IT & Technology', icon: '💻', note: 'SaaS growth, product SEO & demand generation' },
];
---

<BaseLayout
  title="Enterprise Website Development, SEO & Digital Marketing Services | Crewtec Bangalore"
  description="Crewtec delivers enterprise website development, technical SEO, and paid marketing campaigns that generate qualified leads for Indian enterprises."
  canonical="/digital-growth"
>
  <Header />
  <main>

    <!-- ═══════════════════════════════════════════════
         HERO — navy bg, dot-grid
    ═══════════════════════════════════════════════ -->
    <section class="dg-hero">
      <div class="dg-hero-inner">
        <!-- Breadcrumb -->
        <nav class="dg-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Digital Growth</span>
        </nav>

        <h1 class="dg-hero-h1">
          Enterprise Website Development,<br />SEO &amp; Digital Marketing
        </h1>
        <p class="dg-hero-sub">
          High-performance websites, organic search growth, and ROI-driven paid campaigns — built for enterprise decision-makers, not casual visitors.
        </p>

        <div class="dg-hero-ctas">
          <a href="/contact" class="dg-cta-primary">Start a Digital Growth Project →</a>
          <a href="#services" class="dg-cta-outline">See Our Services</a>
        </div>

        <div class="dg-trust-pill">
          <span>✓ SEO-First Development</span>
          <span class="dg-pill-sep">·</span>
          <span>✓ Enterprise Clients</span>
          <span class="dg-pill-sep">·</span>
          <span>✓ ROI-Focused Campaigns</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         STATS BAR — teal bg
    ═══════════════════════════════════════════════ -->
    <section class="dg-stats-bar">
      <div class="dg-stats-inner">
        <div class="dg-stat">
          <span class="dg-stat-value">3x</span>
          <span class="dg-stat-label">Average Lead Increase</span>
        </div>
        <div class="dg-stat-divider"></div>
        <div class="dg-stat">
          <span class="dg-stat-value">Top 3</span>
          <span class="dg-stat-label">Google Rankings Delivered</span>
        </div>
        <div class="dg-stat-divider"></div>
        <div class="dg-stat">
          <span class="dg-stat-value">₹50Cr+</span>
          <span class="dg-stat-label">Ad Spend Managed Annually</span>
        </div>
        <div class="dg-stat-divider"></div>
        <div class="dg-stat">
          <span class="dg-stat-value">220%</span>
          <span class="dg-stat-label">Avg Organic Traffic Growth</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         THREE SERVICE CARDS — white bg
    ═══════════════════════════════════════════════ -->
    <section class="dg-services" id="services">
      <div class="dg-section-inner">
        <div class="dg-section-label">What We Deliver</div>
        <h2 class="dg-section-h2">Our Digital Growth Services</h2>
        <p class="dg-section-sub">Three specialised practices, one integrated team, measurable results from month one.</p>

        <div class="dg-cards">
          {digitalGrowthServices.map((svc) => (
            <article class="dg-card">
              <div class="dg-card-accent"></div>
              <div class="dg-card-body">
                <div class="dg-card-header">
                  <span class="dg-card-icon">{svc.icon}</span>
                  <span class="dg-card-num">Service {svc.number}</span>
                </div>
                <h3 class="dg-card-title">{svc.name}</h3>
                <p class="dg-card-desc">{svc.fullDesc}</p>

                <ul class="dg-card-features">
                  {svc.features.slice(0, 4).map(f => (
                    <li>
                      <span class="dg-feat-check">✓</span>
                      {f}
                    </li>
                  ))}
                </ul>

                <div class="dg-card-results">
                  {svc.results.map(r => (
                    <div class="dg-result-stat">
                      <span class="dg-result-val">{r.value}</span>
                      <span class="dg-result-lbl">{r.label}</span>
                    </div>
                  ))}
                </div>

                <a href={`/digital-growth/${svc.id}`} class="dg-card-cta">
                  Explore {svc.name} →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         WHY DIGITAL PRESENCE MATTERS — bg #F5F9FF
    ═══════════════════════════════════════════════ -->
    <section class="dg-why">
      <div class="dg-section-inner">
        <div class="dg-section-label">The Business Case</div>
        <h2 class="dg-section-h2">Why Enterprise Businesses Need a Strong Digital Foundation</h2>

        <div class="dg-why-grid">
          <div class="dg-why-left">
            <p>
              For Indian enterprises, digital presence is no longer a marketing function — it is a revenue infrastructure decision. B2B buyers complete 57–70% of their purchase journey before ever speaking to a sales representative. If your website does not rank, does not convert, and does not communicate authority, your pipeline is already leaking at the top.
            </p>
            <p>
              Search engine optimisation compounds over time in a way that paid advertising cannot. A technically sound website with strong topical authority continues generating qualified leads months and years after the initial investment, creating a sustainable moat against competitors who rely exclusively on ad spend.
            </p>
            <p>
              For enterprises with complex buyer journeys — manufacturing, BFSI, healthcare, professional services — the quality of the digital experience signals trust and credibility. Slow sites, broken mobile experiences, and thin content directly reduce conversion rates among senior decision-makers who have no patience for poor digital execution.
            </p>
            <p>
              Paid marketing, when layered on top of organic and owned channels, accelerates demand generation in ways that scale predictably. The key is integration: campaigns that drive to conversion-optimised landing pages, backed by CRM tracking, and fed by SEO-informed keyword intelligence.
            </p>
          </div>

          <div class="dg-why-right">
            <div class="dg-stat-box">
              <span class="dg-stat-box-val">67%</span>
              <span class="dg-stat-box-lbl">of B2B purchase decisions start with an online search (Gartner, 2024)</span>
            </div>
            <div class="dg-stat-box">
              <span class="dg-stat-box-val">8x</span>
              <span class="dg-stat-box-lbl">more leads from SEO vs paid alone at enterprise scale and long term</span>
            </div>
            <div class="dg-stat-box">
              <span class="dg-stat-box-val">53%</span>
              <span class="dg-stat-box-lbl">of mobile users abandon a site that takes more than 3 seconds to load</span>
            </div>
            <div class="dg-stat-box">
              <span class="dg-stat-box-val">₹2.5L Cr</span>
              <span class="dg-stat-box-lbl">projected size of India's digital advertising market by 2026</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         OUR METHODOLOGY — white bg
    ═══════════════════════════════════════════════ -->
    <section class="dg-approach">
      <div class="dg-section-inner">
        <div class="dg-section-label">How We Work</div>
        <h2 class="dg-section-h2">Our Digital Growth Methodology</h2>
        <p class="dg-section-sub">A repeatable, data-driven process that removes guesswork and ties every action to your revenue goals.</p>

        <div class="dg-process-grid">
          <div class="dg-process-card">
            <div class="dg-process-num">01</div>
            <div class="dg-process-icon">🔍</div>
            <h3 class="dg-process-title">Discovery &amp; Audit</h3>
            <p class="dg-process-desc">We audit your current digital footprint, competitors, and keyword opportunities to identify the highest-impact starting points for your specific business context.</p>
          </div>
          <div class="dg-process-card">
            <div class="dg-process-num">02</div>
            <div class="dg-process-icon">📐</div>
            <h3 class="dg-process-title">Strategy &amp; Planning</h3>
            <p class="dg-process-desc">A bespoke digital roadmap aligned to your sales funnel and revenue targets — prioritised by impact, sequenced for quick wins alongside long-term compounding gains.</p>
          </div>
          <div class="dg-process-card">
            <div class="dg-process-num">03</div>
            <div class="dg-process-icon">⚙️</div>
            <h3 class="dg-process-title">Execution</h3>
            <p class="dg-process-desc">Agile delivery across web development, content, SEO, and campaigns in parallel sprints — no sequential handoffs that slow delivery and lose momentum.</p>
          </div>
          <div class="dg-process-card">
            <div class="dg-process-num">04</div>
            <div class="dg-process-icon">📊</div>
            <h3 class="dg-process-title">Measurement &amp; Optimisation</h3>
            <p class="dg-process-desc">Monthly reporting with clear KPIs — traffic, leads, rankings, and ROI — with budget and effort continuously reallocated toward what is generating the highest return.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         INDUSTRIES — bg #F5F9FF
    ═══════════════════════════════════════════════ -->
    <section class="dg-industries">
      <div class="dg-section-inner">
        <div class="dg-section-label">Sector Expertise</div>
        <h2 class="dg-section-h2">Industries We Drive Digital Growth For</h2>
        <p class="dg-section-sub">Deep familiarity with the compliance environments, buyer behaviours, and competitive dynamics of each sector.</p>

        <div class="dg-industry-grid">
          {industries.map(ind => (
            <a href={`/industries/${ind.id}`} class="dg-industry-tile">
              <span class="dg-ind-icon">{ind.icon}</span>
              <span class="dg-ind-name">{ind.name}</span>
              <span class="dg-ind-note">{ind.note}</span>
              <span class="dg-ind-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         CASE STUDY — navy bg
    ═══════════════════════════════════════════════ -->
    <section class="dg-case-study">
      <div class="dg-section-inner">
        <div class="dg-section-label" style="color: rgba(255,255,255,0.5);">Proven Results</div>
        <h2 class="dg-section-h2" style="color: #fff;">Proven Digital Results</h2>

        <div class="dg-cs-card">
          <div class="dg-cs-meta">
            <span class="dg-cs-tag">Healthcare · Website Rebuild + SEO</span>
            <span class="dg-cs-timeline">12-month engagement · Bangalore</span>
          </div>
          <h3 class="dg-cs-title">
            Leading Private Hospital Chain: 220% Traffic Growth &amp; #1 Google Rankings in 12 Months
          </h3>
          <p class="dg-cs-body">
            A 400-bed multi-speciality hospital group in Bangalore was losing patient enquiries to smaller competitors who ranked higher on Google. Their legacy website was slow, non-mobile-friendly, and had zero structured content strategy. Crewtec rebuilt the website from the ground up on a headless CMS, implemented a full technical SEO overhaul, and launched a targeted content programme covering 40+ treatment keywords.
          </p>

          <div class="dg-cs-results">
            <div class="dg-cs-result">
              <span class="dg-cs-result-val">3x</span>
              <span class="dg-cs-result-lbl">Increase in qualified patient enquiries</span>
            </div>
            <div class="dg-cs-result">
              <span class="dg-cs-result-val">#1</span>
              <span class="dg-cs-result-lbl">Google ranking for 12 priority treatment keywords</span>
            </div>
            <div class="dg-cs-result">
              <span class="dg-cs-result-val">220%</span>
              <span class="dg-cs-result-lbl">Organic traffic increase within 12 months</span>
            </div>
          </div>

          <a href="/contact" class="dg-cs-cta">Get Similar Results for Your Business →</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         CTA BANNER — teal bg
    ═══════════════════════════════════════════════ -->
    <section class="dg-cta-banner">
      <div class="dg-section-inner dg-cta-banner-inner">
        <div>
          <h2 class="dg-cta-banner-h2">Ready to turn your digital presence into a growth engine?</h2>
          <p class="dg-cta-banner-sub">Talk to our team for a free digital audit — we'll identify your top three growth opportunities within 48 hours.</p>
        </div>
        <div class="dg-cta-banner-actions">
          <a href="/contact" class="dg-cta-banner-btn-primary">Get Your Free Digital Audit →</a>
          <a href="tel:+919986437648" class="dg-cta-banner-btn-outline">📞 Call Us Now</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ── GLOBAL LAYOUT HELPERS ─────────────────────── */
.dg-section-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}
.dg-section-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #00B4A0;
  margin-bottom: 8px;
}
.dg-section-h2 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  font-weight: 700;
  color: #0A1628;
  margin-bottom: 12px;
  line-height: 1.2;
}
.dg-section-sub {
  font-size: 1rem;
  color: #5a738a;
  max-width: 640px;
  margin-bottom: 40px;
  line-height: 1.6;
}

/* ── HERO ─────────────────────────────────────── */
.dg-hero {
  background: #0A1628;
  padding: 72px 0 64px;
  position: relative;
  overflow: hidden;
}
.dg-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(0,180,160,0.1) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
}
.dg-hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 1;
}
.dg-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.45);
  margin-bottom: 24px;
}
.dg-breadcrumb a {
  color: rgba(255,255,255,0.45);
  transition: color 0.2s;
}
.dg-breadcrumb a:hover { color: #00B4A0; }
.dg-breadcrumb span:last-child { color: rgba(255,255,255,0.7); }

.dg-hero-h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  margin-bottom: 20px;
  max-width: 760px;
}
.dg-hero-sub {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.65);
  max-width: 620px;
  line-height: 1.7;
  margin-bottom: 36px;
}
.dg-hero-ctas {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 32px;
}
.dg-cta-primary {
  display: inline-flex;
  align-items: center;
  padding: 14px 28px;
  background: #00B4A0;
  color: #fff;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.95rem;
  transition: background 0.2s, transform 0.2s;
  box-shadow: 0 4px 20px rgba(0,180,160,0.4);
}
.dg-cta-primary:hover { background: #009d8c; transform: translateY(-2px); }
.dg-cta-outline {
  display: inline-flex;
  align-items: center;
  padding: 14px 28px;
  border: 1.5px solid rgba(255,255,255,0.3);
  color: #fff;
  border-radius: 10px;
  font-weight: 600;
  font-size: 0.95rem;
  transition: border-color 0.2s, background 0.2s;
}
.dg-cta-outline:hover { border-color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.06); }

.dg-trust-pill {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 100px;
  padding: 8px 20px;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.7);
  font-weight: 600;
  flex-wrap: wrap;
}
.dg-pill-sep { color: rgba(255,255,255,0.3); }

/* ── STATS BAR ────────────────────────────────── */
.dg-stats-bar {
  background: #00B4A0;
  padding: 32px 24px;
}
.dg-stats-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 24px;
  flex-wrap: wrap;
}
.dg-stat {
  text-align: center;
}
.dg-stat-value {
  display: block;
  font-family: 'Syne', sans-serif;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  color: #fff;
}
.dg-stat-label {
  display: block;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.8);
  margin-top: 4px;
  font-weight: 500;
}
.dg-stat-divider {
  width: 1px;
  height: 48px;
  background: rgba(255,255,255,0.25);
}
@media (max-width: 640px) {
  .dg-stat-divider { display: none; }
}

/* ── SERVICE CARDS ────────────────────────────── */
.dg-services {
  background: #fff;
  padding: 80px 0;
}
.dg-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
@media (max-width: 1024px) {
  .dg-cards { grid-template-columns: 1fr; }
}
.dg-card {
  border: 1.5px solid #e8eef5;
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2px 12px rgba(0,0,0,0.05);
  transition: box-shadow 0.25s, transform 0.25s;
  display: flex;
  flex-direction: column;
}
.dg-card:hover {
  box-shadow: 0 8px 32px rgba(0,180,160,0.12);
  transform: translateY(-4px);
}
.dg-card-accent {
  height: 3px;
  background: #00B4A0;
  width: 100%;
}
.dg-card-body {
  padding: 28px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.dg-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.dg-card-icon {
  font-size: 2.2rem;
}
.dg-card-num {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #00B4A0;
  background: rgba(0,180,160,0.08);
  padding: 4px 10px;
  border-radius: 100px;
}
.dg-card-title {
  font-family: 'Syne', sans-serif;
  font-size: 1.2rem;
  font-weight: 700;
  color: #0A1628;
  margin-bottom: 12px;
}
.dg-card-desc {
  font-size: 0.875rem;
  color: #5a738a;
  line-height: 1.65;
  margin-bottom: 20px;
}
.dg-card-features {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}
.dg-card-features li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.82rem;
  color: #3d5166;
  line-height: 1.5;
}
.dg-feat-check {
  color: #00B4A0;
  font-weight: 700;
  font-size: 0.75rem;
  margin-top: 2px;
  flex-shrink: 0;
}
.dg-card-results {
  display: flex;
  gap: 16px;
  padding: 16px;
  background: #f5f9ff;
  border-radius: 10px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}
.dg-result-stat {
  flex: 1;
  min-width: 80px;
  text-align: center;
}
.dg-result-val {
  display: block;
  font-family: 'Syne', sans-serif;
  font-size: 1.3rem;
  font-weight: 800;
  color: #00B4A0;
}
.dg-result-lbl {
  display: block;
  font-size: 0.68rem;
  color: #5a738a;
  line-height: 1.4;
  margin-top: 2px;
}
.dg-card-cta {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  font-size: 0.88rem;
  font-weight: 700;
  color: #00B4A0;
  transition: gap 0.2s;
}
.dg-card-cta:hover { color: #009d8c; }

/* ── WHY DIGITAL PRESENCE ─────────────────────── */
.dg-why {
  background: #F5F9FF;
  padding: 80px 0;
}
.dg-why-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
}
@media (max-width: 768px) {
  .dg-why-grid { grid-template-columns: 1fr; }
}
.dg-why-left p {
  font-size: 0.95rem;
  color: #3d5166;
  line-height: 1.75;
  margin-bottom: 20px;
}
.dg-why-right {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.dg-stat-box {
  background: #fff;
  border: 1.5px solid #e8eef5;
  border-left: 4px solid #00B4A0;
  border-radius: 0 12px 12px 0;
  padding: 20px 24px;
}
.dg-stat-box-val {
  display: block;
  font-family: 'Syne', sans-serif;
  font-size: 1.8rem;
  font-weight: 800;
  color: #00B4A0;
  margin-bottom: 4px;
}
.dg-stat-box-lbl {
  font-size: 0.85rem;
  color: #5a738a;
  line-height: 1.5;
}

/* ── METHODOLOGY ──────────────────────────────── */
.dg-approach {
  background: #fff;
  padding: 80px 0;
}
.dg-process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
@media (max-width: 1024px) {
  .dg-process-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .dg-process-grid { grid-template-columns: 1fr; }
}
.dg-process-card {
  background: #F5F9FF;
  border: 1.5px solid #e8eef5;
  border-radius: 16px;
  padding: 28px 22px;
  position: relative;
}
.dg-process-num {
  font-family: 'Syne', sans-serif;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #00B4A0;
  margin-bottom: 8px;
}
.dg-process-icon {
  font-size: 2rem;
