---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { solutions } from '../data/solutions.js';
import { digitalGrowthServices, digitalGrowthMeta } from '../data/digitalGrowth.js';
import { appServices, appMeta } from '../data/appDevelopment.js';
import { industries } from '../data/industries.js';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const itSolutionsHighlight = solutions.slice(0, 6);
const digitalHighlight = digitalGrowthServices;
const appHighlight = appServices.slice(0, 4);
---

<BaseLayout
  title="Enterprise IT Solutions, Website Development & App Development | Crewtec Bangalore"
  description="Crewtec — enterprise IT, web development, SEO & app development from Bangalore. Cybersecurity, cloud, and custom software for Indian enterprises."
  canonical="/"
>
  <Header />

  <!-- ============================================================
       SECTION 1 — HERO
  ============================================================ -->
  <section
    class="relative min-h-screen flex flex-col justify-center overflow-hidden"
    style="background-color: #0A1628;"
  >
    <!-- Dot-grid overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 28px 28px;"
    ></div>

    <!-- Blue radial glow -->
    <div
      class="absolute top-0 right-0 w-2/3 h-full pointer-events-none opacity-20"
      style="background: radial-gradient(ellipse at 80% 30%, #0099EE 0%, transparent 65%);"
    ></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 py-24 lg:py-32 w-full">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left column: copy -->
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full border text-sm font-medium"
               style="border-color: rgba(0,153,238,0.4); color: #0099EE; background: rgba(0,153,238,0.08);">
            <span class="w-2 h-2 rounded-full animate-pulse" style="background:#0099EE;"></span>
            Trusted Enterprise Technology Partner · Bangalore, India
          </div>

          <!-- H1 -->
          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-white mb-6"
            style="font-family: 'Syne', sans-serif;"
          >
            Enterprise Technology Partner for India's Growing Businesses
          </h1>

          <!-- Sub -->
          <p class="text-lg text-gray-300 leading-relaxed mb-8 max-w-xl">
            We deliver cybersecurity, IT infrastructure, enterprise website development, SEO, and custom application development — all under one trusted partnership.
          </p>

          <!-- CTA buttons -->
          <div class="flex flex-wrap gap-4 mb-10">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-7 py-4 rounded-lg font-semibold text-white transition-all duration-200 hover:opacity-90 hover:-translate-y-0.5 shadow-lg"
              style="background: #0099EE;"
            >
              Get Free Consultation →
            </a>
            <a
              href="/it-solutions"
              class="inline-flex items-center gap-2 px-7 py-4 rounded-lg font-semibold text-white border-2 border-white transition-all duration-200 hover:bg-white hover:text-gray-900"
            >
              Explore Our Services
            </a>
          </div>

          <!-- Trust pills -->
          <div class="flex flex-wrap gap-3">
            {[
              '✓ 25+ Years Experience',
              '✓ 500+ Enterprise Clients',
              '✓ iValue Authorised Partner',
            ].map((pill) => (
              <span
                class="px-4 py-1.5 rounded-full text-sm font-medium"
                style="background: rgba(255,255,255,0.08); color: #d1fae5; border: 1px solid rgba(255,255,255,0.12);"
              >
                {pill}
              </span>
            ))}
          </div>
        </div>

        <!-- Right column: pillar cards -->
        <div class="flex flex-col gap-4">
          <!-- IT Solutions -->
          <div
            class="relative p-6 rounded-2xl border flex items-center gap-5 transition-transform duration-300 hover:-translate-y-1"
            style="background: rgba(0,153,238,0.1); border-color: rgba(0,153,238,0.3);"
          >
            <div
              class="flex-shrink-0 w-14 h-14 rounded-xl flex items-center justify-center text-2xl"
              style="background: rgba(0,153,238,0.2);"
            >
              🛡️
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: #0099EE;">IT Solutions</p>
              <h3 class="text-xl font-bold text-white" style="font-family: 'Syne', sans-serif;">17 Solution Categories</h3>
              <p class="text-gray-400 text-sm mt-1">Cybersecurity · Cloud · Infrastructure</p>
            </div>
            <a href="/it-solutions" class="ml-auto text-white opacity-60 hover:opacity-100 text-lg">→</a>
          </div>

          <!-- Digital Growth -->
          <div
            class="relative p-6 rounded-2xl border flex items-center gap-5 transition-transform duration-300 hover:-translate-y-1"
            style="background: rgba(0,180,160,0.1); border-color: rgba(0,180,160,0.3);"
          >
            <div
              class="flex-shrink-0 w-14 h-14 rounded-xl flex items-center justify-center text-2xl"
              style="background: rgba(0,180,160,0.2);"
            >
              📈
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: #00B4A0;">Digital Growth</p>
              <h3 class="text-xl font-bold text-white" style="font-family: 'Syne', sans-serif;">Web · SEO · Ads</h3>
              <p class="text-gray-400 text-sm mt-1">Enterprise websites & paid marketing</p>
            </div>
            <a href="/digital-growth" class="ml-auto text-white opacity-60 hover:opacity-100 text-lg">→</a>
          </div>

          <!-- App Development -->
          <div
            class="relative p-6 rounded-2xl border flex items-center gap-5 transition-transform duration-300 hover:-translate-y-1"
            style="background: rgba(99,102,241,0.1); border-color: rgba(99,102,241,0.3);"
          >
            <div
              class="flex-shrink-0 w-14 h-14 rounded-xl flex items-center justify-center text-2xl"
              style="background: rgba(99,102,241,0.2);"
            >
              💻
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: #6366F1;">App Development</p>
              <h3 class="text-xl font-bold text-white" style="font-family: 'Syne', sans-serif;">Web · Mobile · Custom</h3>
              <p class="text-gray-400 text-sm mt-1">End-to-end software engineering</p>
            </div>
            <a href="/app-development" class="ml-auto text-white opacity-60 hover:opacity-100 text-lg">→</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust bar -->
    <div class="relative z-10 w-full border-t" style="border-color: rgba(255,255,255,0.08); background: rgba(255,255,255,0.03);">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-6 flex flex-col sm:flex-row items-center gap-6">
        <p class="text-gray-400 text-sm font-medium whitespace-nowrap">Trusted by 500+ enterprises</p>
        <div class="flex flex-wrap gap-3 items-center">
          {['BFSI Leader', 'Manufacturing Co.', 'Healthcare Group', 'Real Estate Developer', 'IT Services Firm', 'Logistics Company'].map((name) => (
            <div
              class="px-4 py-2 rounded-lg text-xs font-medium text-gray-400 border"
              style="border-color: rgba(255,255,255,0.1); background: rgba(255,255,255,0.04);"
            >
              {name}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 2 — THREE PILLARS
  ============================================================ -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4" style="font-family: 'Syne', sans-serif; color: #0A1628;">
          Three Pillars. One Partner.
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Crewtec delivers end-to-end technology and digital services so you never need another vendor.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">

        <!-- Pillar 1: IT Solutions -->
        <div class="relative rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-shadow duration-300 flex flex-col">
          <div class="p-8 flex-1 flex flex-col">
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center text-2xl mb-5"
              style="background: rgba(0,153,238,0.1);"
            >
              🛡️
            </div>
            <h3 class="text-2xl font-bold mb-3" style="font-family: 'Syne', sans-serif; color: #0A1628;">
              Enterprise IT Solutions
            </h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Comprehensive cybersecurity, cloud infrastructure, and system integration through our authorised iValue partnership.
            </p>
            <ul class="space-y-2 mb-8 flex-1">
              {['Firewall & Network Security', 'Endpoint Protection', 'Cloud Infrastructure', 'Identity & Access Management', 'SOC & Threat Monitoring'].map((item) => (
                <li class="flex items-center gap-2 text-sm text-gray-700">
                  <span class="w-4 h-4 rounded-full flex items-center justify-center flex-shrink-0 text-xs" style="background: rgba(0,153,238,0.15); color: #0099EE;">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <a
              href="/it-solutions"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white transition-all duration-200 hover:opacity-90"
              style="background: #0099EE;"
            >
              Explore IT Solutions →
            </a>
          </div>
          <div class="h-1 w-full" style="background: #0099EE;"></div>
        </div>

        <!-- Pillar 2: Digital Growth -->
        <div class="relative rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-shadow duration-300 flex flex-col">
          <div class="p-8 flex-1 flex flex-col">
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center text-2xl mb-5"
              style="background: rgba(0,180,160,0.1);"
            >
              🌐
            </div>
            <h3 class="text-2xl font-bold mb-3" style="font-family: 'Syne', sans-serif; color: #0A1628;">
              Digital Growth Services
            </h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              High-performance enterprise websites, SEO strategies, and paid marketing campaigns that generate qualified leads.
            </p>
            <ul class="space-y-2 mb-8 flex-1">
              {['Enterprise Website Development', 'SEO & Organic Growth', 'Paid Marketing & PPC'].map((item) => (
                <li class="flex items-center gap-2 text-sm text-gray-700">
                  <span class="w-4 h-4 rounded-full flex items-center justify-center flex-shrink-0 text-xs" style="background: rgba(0,180,160,0.15); color: #00B4A0;">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <a
              href="/digital-growth"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white transition-all duration-200 hover:opacity-90"
              style="background: #00B4A0;"
            >
              Explore Digital Growth →
            </a>
          </div>
          <div class="h-1 w-full" style="background: #00B4A0;"></div>
        </div>

        <!-- Pillar 3: App Development -->
        <div class="relative rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-shadow duration-300 flex flex-col">
          <div class="p-8 flex-1 flex flex-col">
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center text-2xl mb-5"
              style="background: rgba(99,102,241,0.1);"
            >
              ⚡
            </div>
            <h3 class="text-2xl font-bold mb-3" style="font-family: 'Syne', sans-serif; color: #0A1628;">
              Application Development
            </h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Custom web apps, mobile applications, and enterprise software built for scale, security, and performance.
            </p>
            <ul class="space-y-2 mb-8 flex-1">
              {['Web Application Development', 'Mobile App Development', 'Custom Software & ERP', 'API & Systems Integration'].map((item) => (
                <li class="flex items-center gap-2 text-sm text-gray-700">
                  <span class="w-4 h-4 rounded-full flex items-center justify-center flex-shrink-0 text-xs" style="background: rgba(99,102,241,0.15); color: #6366F1;">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <a
              href="/app-development"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white transition-all duration-200 hover:opacity-90"
              style="background: #6366F1;"
            >
              Explore App Development →
            </a>
          </div>
          <div class="h-1 w-full" style="background: #6366F1;"></div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 3 — WHY CHOOSE CREWTEC
  ============================================================ -->
  <section class="py-24" style="background: #F5F9FF;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4" style="font-family: 'Syne', sans-serif; color: #0A1628;">
          Why Enterprises Choose Crewtec
        </h2>
        <p class="text-lg text-gray-600 max-w-xl mx-auto">
          One partner. Complete capability. Enterprise-grade delivery across every technology domain.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-8">
        {[
          {
            icon: '🤝',
            title: 'End-to-End Digital Partner',
            desc: 'From IT infrastructure to website to mobile app — we manage every technology touchpoint so you have one accountable partner instead of a patchwork of vendors.',
          },
          {
            icon: '🏆',
            title: 'Enterprise-Grade Standards',
            desc: 'ISO-aligned processes, security-first approach, and enterprise SLAs across all our services. We operate the way large enterprises expect their vendors to operate.',
          },
          {
            icon: '🎯',
            title: 'SEO-First Development',
            desc: 'Every website we build is architected for search visibility and organic lead generation from day one — not as an afterthought added during launch.',
          },
          {
            icon: '🔒',
            title: 'Reliable & Secure',
            desc: '24/7 support, proactive monitoring, and a Bangalore-based team with pan-India delivery capability — so your systems stay up and your data stays protected.',
          },
        ].map((feat) => (
          <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-300">
            <div class="text-4xl mb-4">{feat.icon}</div>
            <h3 class="text-xl font-bold mb-3" style="font-family: 'Syne', sans-serif; color: #0A1628;">
              {feat.title}
            </h3>
            <p class="text-gray-600 leading-relaxed">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 4 — INDUSTRIES WE SERVE
  ============================================================ -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-12">
        <div>
          <h2 class="text-4xl font-bold" style="font-family: 'Syne', sans-serif; color: #0A1628;">
            Industries We Serve
          </h2>
          <p class="text-gray-600 mt-2">Sector-specific expertise backed by enterprise technology depth.</p>
        </div>
        <span
          class="sm:ml-auto px-4 py-2 rounded-full text-sm font-semibold"
          style="background: rgba(0,153,238,0.1); color: #0099EE;"
        >
          10+ Sectors
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {industries.map((ind) => (
          <a
            href={`/industries/${ind.id}`}
            class="group p-5 rounded-2xl border border-gray-100 hover:border-blue-200 hover:shadow-md transition-all duration-200 flex flex-col items-center text-center gap-3 bg-white hover:bg-blue-50"
          >
            <span class="text-3xl">{ind.icon}</span>
            <span class="text-sm font-semibold text-gray-700 group-hover:text-blue-700 leading-snug">
              {ind.name}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 5 — IT SOLUTIONS SHOWCASE
  ============================================================ -->
  <section class="py-24" style="background: #0A1628;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-12">
        <div>
          <h2 class="text-4xl font-bold text-white" style="font-family: 'Syne', sans-serif;">
            Enterprise IT Solutions
          </h2>
          <p class="text-gray-400 mt-2">17 solution categories across cybersecurity, cloud, and infrastructure.</p>
        </div>
        <a
          href="/it-solutions"
          class="sm:ml-auto px-5 py-2.5 rounded-lg text-sm font-semibold border border-gray-600 text-gray-300 hover:border-blue-400 hover:text-white transition-colors duration-200"
        >
          View All 17 Solutions →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {itSolutionsHighlight.map((s) => (
          <a
            href={`/it-solutions/${s.id}`}
            class="group p-6 rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 flex flex-col"
            style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.08);"
          >
            <div class="text-3xl mb-4">{s.icon}</div>
            <h3 class="text-lg font-bold text-white mb-2" style="font-family: 'Syne', sans-serif;">
              {s.name}
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed flex-1 mb-4">{s.shortDesc}</p>
            <span class="text-sm font-semibold" style="color: #0099EE;">
              Learn More →
            </span>
          </a>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/it-solutions"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white transition-all duration-200 hover:opacity-90"
          style="background: #0099EE;"
        >
          View All 17 Solutions →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 6 — DIGITAL GROWTH SHOWCASE
  ============================================================ -->
  <section class="py-24" style="background: #F5F9FF;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1 rounded-full text-sm font-semibold mb-4" style="background: rgba(0,180,160,0.1); color: #00B4A0;">
          Digital Growth Services
        </span>
        <h2 class="text-4xl font-bold" style="font-family: 'Syne', sans-serif; color: #0A1628;">
          Turn Your Digital Presence Into a
          <span style="color: #00B4A0;"> Revenue Asset</span>
        </h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          Enterprise website development, SEO, and paid marketing managed as one integrated growth programme.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        {digitalHighlight.map((s) => (
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-shadow duration-300 overflow-hidden flex flex-col">
            <div class="p-7 flex-1 flex flex-col">
              <div class="text-3xl mb-4">{s.icon}</div>
              <h3 class="text-xl font-bold mb-3" style="font-family: 'Syne', sans-serif; color: #0A1628;">
                {s.name}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6 flex-1">{s.shortDesc}</p>

              <!-- Results stats -->
              <div class="grid grid-cols-3 gap-3 mb-6 p-4 rounded-xl" style="background: #F5F9FF;">
                {s.results.map((r) => (
                  <div class="text-center">
                    <p class="text-lg font-bold" style="color: #00B4A0; font-family: 'Syne', sans-serif;">{r.value}</p>
                    <p class="text-xs text-gray-500 leading-tight mt-0.5">{r.label}</p>
                  </div>
                ))}
              </div>

              <a
                href={`/digital-growth/${s.id}`}
                class="inline-flex items-center gap-1 font-semibold text-sm transition-colors duration-200 hover:opacity-80"
                style="color: #00B4A0;"
              >
                Explore {s.name} →
              </a>
            </div>
            <div class="h-1 w-full" style="background: #00B4A0;"></div>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/digital-growth"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold text-white transition-all duration-200 hover:opacity-90"
          style="background: #00B4A0;"
        >
          View All Digital Growth Services →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 7 — APP DEVELOPMENT SHOWCASE
  ============================================================ -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1 rounded-full text-sm font-semibold mb-4" style="background: rgba(99,102,241,0.1); color: #6366F1;">
          Application Development
        </span>
        <h2 class="text-4xl font-bold" style="font-family: 'Syne', sans-serif; color: #0A1628;">
          Software Built to
          <span style="color: #6366F1;"> Scale With You</span>
        </h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          From MVP to enterprise platform — custom web apps, mobile apps, and integrations engineered for growth.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {appHighlight.map((s) => (
          <div class="rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden flex flex-col hover:-translate-y-1">
            <div class="p-7 flex-1 flex flex-col">
              <div class="flex items-start gap-4 mb-4">
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center text-xl flex-shrink-0"
                  style="background: rgba(99,102,241,0.1);"
                >
                  {s.icon}
                </div>
                <div>
                  <h3 class="text-lg font-bold" style="font-family: 'Syne', sans-serif; color: #0A1628;">
                    {s.name}
                  </h3>
                  <p class="text-gray-500 text-sm mt-0.5">{s.shortDesc}</p>
                </div>
              </div>

              <!-- 2 key stats -->
              <div class="flex gap-4 my-4">
                {s.results.slice(0, 2).map((r) => (
                  <div class="flex-1 p-3 rounded-lg text-center" style="background: rgba(99,102,241,0.05);">
                    <p class="text-base font-bold" style="color: #6366F1; font-family: 'Syne', sans-serif;">{r.value}</p>
                    <p class="text-xs text-gray-500 leading-tight mt-0.5">{r.label}</p>
                  </div>
                ))}
              </div>

              <a
                href={`/app-development/${s.id}`}
                class="inline-flex items-center gap-1 font-semibold text-sm mt-auto transition-colors duration-200 hover:opacity-80"
                style="color: #6366F1;"
              >
                Learn More →
              </a>
            </div>
            <div class="h-1 w-full" style="background: #6366F1;"></div>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/app-development"
