---
import BaseLayout from '../layouts/BaseLayout.astro';
import { solutions, colorMap } from '../data/solutions.js';
---

<BaseLayout
  title="iValue Technology Partner | Crewtec Bangalore"
  description="Crewtec is an authorised iValue Technology Partner in Bangalore, supplying cybersecurity and IT infrastructure products from Check Point, CyberArk, SentinelOne, Thales, Splunk and 80+ other global vendors."
  canonical="/"
>
  <!-- ── SIMPLE HEADER ────────────────────────────────────────────────────────── -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-2">
          <img src="/logo-nav.svg" alt="Crewtec" class="h-10 w-auto" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <span class="hidden items-center font-bold text-lg text-[#111111]" style="font-family:'Rajdhani',sans-serif;">Crewtec</span>
        </div>
        <div class="flex items-center gap-4 text-sm font-medium">
          <a href="tel:+919986437648" class="hidden sm:inline text-[#111111] hover:text-[#DC2626] transition-colors">+91 99864 37648</a>
          <a href="mailto:sales@crewtec.in" class="hidden sm:inline text-[#111111] hover:text-[#DC2626] transition-colors">sales@crewtec.in</a>
          <a href="https://wa.me/919986437648" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white hover:opacity-90 transition-all" style="background:#25D366;">
            WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- ── HERO ─────────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden" style="background:#0A0A0A;">
    <div class="absolute inset-0 pointer-events-none" style="background-image:radial-gradient(rgba(255,255,255,0.04) 1px,transparent 1px);background-size:28px 28px;"></div>
    <div class="absolute top-0 right-0 w-2/3 h-full pointer-events-none opacity-20" style="background:radial-gradient(ellipse at 80% 30%,#D97706 0%,transparent 65%);"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-10 py-20 text-center">
      <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full border text-sm font-medium" style="border-color:rgba(217,119,6,0.4);color:#D97706;background:rgba(217,119,6,0.08);">
        Authorised iValue Technology Partner
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight text-white mb-6" style="font-family:'Rajdhani',sans-serif;">
        Cybersecurity &amp; IT Infrastructure Products
      </h1>
      <p class="text-lg text-gray-300 leading-relaxed max-w-2xl mx-auto mb-10">
        Crewtec supplies, deploys and supports technology from iValue's vendor ecosystem — 80+ global brands across cybersecurity, infrastructure and data platforms. Browse our product portfolio below, or get in touch to discuss your requirement.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:+919986437648" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-semibold text-white transition-all hover:opacity-90 shadow-lg" style="background:#D97706;">
          Call Us →
        </a>
        <a href="mailto:sales@crewtec.in" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-semibold text-white border-2 border-white transition-all hover:bg-white hover:text-gray-900">
          Email Us
        </a>
      </div>
    </div>
  </section>

  <!-- ── PRODUCT CATEGORIES ───────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {solutions.map(sol => {
          const c = colorMap[sol.color] || colorMap.blue;
          return (
            <div class="p-6 rounded-2xl border-2" style={`border-color:${c.border};background:${c.bg}20;`}>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-2xl">{sol.icon}</span>
                <h2 class="text-lg font-bold" style={`font-family:'Rajdhani',sans-serif;color:${c.text};`}>{sol.name}</h2>
              </div>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">{sol.shortDesc}</p>
              <div class="flex flex-wrap gap-2">
                {sol.brands.map(b => (
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-white border border-gray-200 text-gray-700">{b.name}</span>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────────────────── -->
  <section class="py-20" style="background:#F5F5F5;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#111111;">
        Need one of these products deployed?
      </h2>
      <p class="text-gray-600 mb-8">
        Get in touch and we'll help you find and deploy the right technology from our iValue portfolio.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:+919986437648" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-semibold text-white transition-all hover:opacity-90 shadow-lg" style="background:#DC2626;">
          📞 +91 99864 37648
        </a>
        <a href="mailto:sales@crewtec.in" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-semibold border-2 transition-all hover:bg-[#DC2626] hover:text-white hover:border-[#DC2626]" style="border-color:#DC2626;color:#DC2626;">
          ✉ sales@crewtec.in
        </a>
      </div>
    </div>
  </section>

  <!-- ── SIMPLE FOOTER ────────────────────────────────────────────────────────── -->
  <footer class="bg-[#0A0A0A] text-white">
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img src="/logo.svg" alt="Crewtec" class="h-8 w-auto" />
        <span class="text-sm text-white/50">No. 10/11, Maragondanahalli Tavarekere, Bangalore – 562130</span>
      </div>
      <p class="text-sm text-white/40">&copy; {new Date().getFullYear()} Crewtec. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
