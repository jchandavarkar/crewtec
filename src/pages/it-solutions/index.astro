---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { solutions, colorMap } from '../../data/solutions.js';

const grouped = {
  'Cybersecurity': solutions.filter(s => ['firewall-solutions','endpoint-security','email-security','data-loss-prevention','soc-solutions','zero-trust-solutions','mobile-security-solutions'].includes(s.id)),
  'Data & Identity': solutions.filter(s => ['identity-solutions','hsm-solutions','data-forensic-solutions','encryption-solutions'].includes(s.id)),
  'Infrastructure': solutions.filter(s => ['network-security','hybrid-cloud-solutions','application-infrastructure','alm-solutions'].includes(s.id)),
  'Hardware & Services': solutions.filter(s => ['hardware-supply','professional-services'].includes(s.id)),
};

const stats = [
  { number: '17', label: 'Solution Categories' },
  { number: '50+', label: 'Global Brands' },
  { number: '500+', label: 'Enterprise Deployments' },
  { number: '24/7', label: 'Support' },
];

const whyCards = [
  {
    icon: '🏆',
    title: 'Certified Engineers',
    desc: 'Our team holds vendor certifications across Check Point, Thales, Palo Alto, and 15+ other brands, ensuring every deployment is backed by deep product expertise.',
  },
  {
    icon: '🔒',
    title: 'Security-First Approach',
    desc: 'Every deployment follows zero-trust principles and CERT-In aligned security frameworks, so your enterprise defences are built to industry-recognised standards.',
  },
  {
    icon: '⚡',
    title: 'Fast Deployment',
    desc: 'Pre-validated deployment playbooks cut implementation time by 40% versus the industry average — reducing disruption and accelerating time-to-protection.',
  },
  {
    icon: '🤝',
    title: 'Long-Term Partnership',
    desc: 'We don\'t just install — we monitor, maintain, and continuously optimise your IT environment with ongoing support, health checks, and proactive recommendations.',
  },
];

const processSteps = [
  { num: '01', title: 'Assessment & Gap Analysis', desc: 'We audit your current security and infrastructure posture to identify gaps and risks.' },
  { num: '02', title: 'Solution Design & Vendor Selection', desc: 'Our architects design a right-sized solution and select the best-fit vendors from our 50+ brand portfolio.' },
  { num: '03', title: 'Proof of Concept', desc: 'We run a scoped PoC in your environment to validate the solution before full rollout.' },
  { num: '04', title: 'Deployment & Integration', desc: 'Certified engineers deploy, configure, and integrate the solution with your existing infrastructure.' },
  { num: '05', title: 'Monitoring & Ongoing Support', desc: 'Post-deployment, we monitor, maintain, and continuously optimise your environment.' },
];

const featuredBrands = [
  { name: 'Check Point', type: 'Next-Gen Firewall' },
  { name: 'Thales', type: 'Data Security' },
  { name: 'Palo Alto', type: 'Network Security' },
  { name: 'Akamai', type: 'Cloud & CDN Security' },
  { name: 'CrowdStrike', type: 'Endpoint Security' },
  { name: 'Microsoft', type: 'Identity & Cloud' },
];
---

<BaseLayout
  title="Enterprise IT Solutions & Cybersecurity Services Bangalore | Crewtec"
  description="Crewtec delivers 17 enterprise IT solution categories — cybersecurity, cloud, and network security as an authorised iValue partner in Bangalore."
  canonical="/it-solutions"
>
  <Header />

  <main>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 1. HERO                                        -->
    <!-- ═══════════════════════════════════════════════ -->
    <section class="relative overflow-hidden" style="background:#0A1628;">
      <!-- Dot-grid background -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background-image:radial-gradient(circle, rgba(0,153,238,0.07) 1px, transparent 1px);background-size:44px 44px;"
      ></div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 lg:py-28">

        <!-- Breadcrumb -->
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm" style="color:rgba(255,255,255,0.5);">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li style="color:rgba(255,255,255,0.85);">IT Solutions</li>
          </ol>
        </nav>

        <div class="flex flex-col lg:flex-row lg:items-center gap-10 lg:gap-16">

          <!-- Text block -->
          <div class="flex-1">
            <!-- iValue badge -->
            <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full text-xs font-semibold tracking-wide" style="background:rgba(0,153,238,0.15);color:#0099EE;border:1px solid rgba(0,153,238,0.3);">
              Authorised iValue Partner ✓
            </div>

            <h1
              class="text-4xl lg:text-6xl font-extrabold text-white mb-6 leading-tight"
              style="font-family:'Syne',sans-serif;"
            >
              Enterprise IT Solutions &amp; Cybersecurity Services
            </h1>

            <p class="text-lg mb-10 max-w-2xl" style="color:rgba(255,255,255,0.7);">
              Comprehensive cybersecurity, cloud infrastructure, and system integration through our authorised iValue partnership — 17 solution categories, 50+ global brands, pan-India delivery.
            </p>

            <div class="flex flex-wrap gap-4">
              <a
                href="/contact"
                class="inline-flex items-center px-7 py-4 rounded-xl font-bold text-white text-base transition-all duration-200 hover:-translate-y-0.5"
                style="background:#0099EE;box-shadow:0 4px 20px rgba(0,153,238,0.4);"
              >
                Get a Free IT Consultation →
              </a>
              <a
                href="#solutions"
                class="inline-flex items-center px-7 py-4 rounded-xl font-bold text-white text-base border-2 transition-all duration-200 hover:bg-white hover:text-[#0A1628]"
                style="border-color:rgba(255,255,255,0.4);"
              >
                View All Solutions
              </a>
            </div>
          </div>

          <!-- Visual accent — stat highlights -->
          <div class="grid grid-cols-2 gap-4 lg:w-72 shrink-0">
            {stats.map(s => (
              <div class="rounded-2xl p-5 text-center" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);">
                <div class="text-3xl font-extrabold text-white mb-1" style="font-family:'Syne',sans-serif;">{s.number}</div>
                <div class="text-xs font-medium" style="color:rgba(255,255,255,0.6);">{s.label}</div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════ -->
    <!-- 2. STATS BAR                                   -->
    <!-- ═══════════════════════════════════════════════ -->
    <section style="background:#0099EE;">
      <div class="max-w-7xl mx-auto px-6 py-10">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center text-white">
          {stats.map(s => (
            <div>
              <div class="text-4xl font-extrabold mb-1" style="font-family:'Syne',sans-serif;">{s.number}</div>
              <div class="text-sm font-medium opacity-90">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════ -->
    <!-- 3. SOLUTIONS BY CATEGORY                       -->
    <!-- ═══════════════════════════════════════════════ -->
    <section id="solutions" class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-14 text-center">
          <h2
            class="text-3xl lg:text-4xl font-extrabold mb-4"
            style="font-family:'Syne',sans-serif;color:#0A1628;"
          >
            Browse All IT Solutions
          </h2>
          <p class="text-gray-500 max-w-2xl mx-auto">
            From perimeter security to application infrastructure — explore our full catalogue of enterprise-grade IT solutions, each backed by 50+ globally certified brands.
          </p>
        </div>

        {Object.entries(grouped).map(([category, sols]) => (
          <div class="mb-16">
            <h3
              class="text-xl font-bold mb-8 pb-3 pl-4"
              style="font-family:'Syne',sans-serif;color:#0A1628;border-left:4px solid #0099EE;"
            >
              {category}
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {sols.map(sol => {
                const c = colorMap[sol.color];
                return (
                  <div class="group bg-white border border-gray-100 rounded-2xl p-6 flex flex-col transition-all duration-200 hover:shadow-[0_8px_32px_rgba(0,0,0,0.1)] hover:-translate-y-0.5">

                    <!-- Top row: icon + badge -->
                    <div class="flex items-start justify-between mb-4">
                      <div
                        class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl"
                        style={`background:${c.bg};`}
                      >
                        {sol.icon}
                      </div>
                      <span
                        class="text-xs font-bold tracking-widest uppercase px-3 py-1 rounded-full"
                        style={`background:${c.bg};color:${c.text};`}
                      >
                        Solution {sol.number}
                      </span>
                    </div>

                    <!-- Name + description -->
                    <h4
                      class="text-lg font-bold mb-2"
                      style="font-family:'Syne',sans-serif;color:#0A1628;"
                    >
                      {sol.name}
                    </h4>
                    <p class="text-sm text-gray-500 mb-4 leading-relaxed flex-1">{sol.shortDesc}</p>

                    <!-- Brand count + CTA -->
                    <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
                      <span class="text-xs text-gray-400 font-medium">{sol.brands.length} brands</span>
                      <a
                        href={`/it-solutions/${sol.id}`}
                        class="text-sm font-semibold transition-colors"
                        style="color:#0099EE;"
                      >
                        Explore →
                      </a>
                    </div>

                  </div>
                );
              })}
            </div>
          </div>
        ))}

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════ -->
    <!-- 4. iVALUE PARTNERSHIP                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <section style="background:#F5F9FF;" class="py-20">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12 text-center">
          <h2
            class="text-3xl lg:text-4xl font-extrabold mb-4"
            style="font-family:'Syne',sans-serif;color:#0A1628;"
          >
            Powered by iValue Group Partnership
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">

          <!-- Left: explanation (2/3) -->
          <div class="lg:col-span-2 space-y-6">
            <p class="text-gray-700 leading-relaxed text-base">
              iValue Group is one of India's leading technology distribution and services companies, with direct authorised partnerships with over 50 global OEM brands across cybersecurity, networking, cloud, and infrastructure. As an authorised iValue partner, Crewtec gains access to official vendor pricing, pre-sales support, certified training, and priority fulfilment — advantages that translate directly into better outcomes for our enterprise customers.
            </p>
            <p class="text-gray-700 leading-relaxed text-base">
              For enterprise buyers, this partnership matters because it removes the risk of counterfeit or grey-market products, ensures full OEM warranty coverage, and guarantees that every solution is deployed by engineers certified directly by the vendor. Crewtec doesn't resell commodity hardware — we architect, deploy, and support complete solution stacks, backed by the vendor relationships and certifications that give you peace of mind at every stage of the engagement.
            </p>

            <!-- Benefits -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
              {[
                'Direct vendor pricing — no grey-market markups',
                'Certified engineers with OEM vendor credentials',
                'Faster procurement through authorised distribution channels',
                'Full OEM warranty and support on every deployment',
              ].map(benefit => (
                <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-blue-100">
                  <span class="shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold text-white mt-0.5" style="background:#0099EE;">✓</span>
                  <span class="text-sm text-gray-700">{benefit}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Right: brand grid (1/3) -->
          <div>
            <p class="text-xs font-bold tracking-widest uppercase text-gray-400 mb-4">Featured Partner Brands</p>
            <div class="grid grid-cols-3 gap-3">
              {featuredBrands.map(brand => (
                <div class="bg-white rounded-xl p-4 border border-gray-100 text-center shadow-sm flex flex-col items-center gap-2">
                  <span class="text-xs font-bold text-[#0A1628] leading-tight">{brand.name}</span>
                  <span class="text-[10px] text-gray-400 leading-tight">{brand.type}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════ -->
    <!-- 5. WHY CREWTEC FOR IT                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <section class="py-20" style="background:#0A1628;">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12 text-center">
          <h2
            class="text-3xl lg:text-4xl font-extrabold text-white mb-4"
            style="font-family:'Syne',sans-serif;"
          >
            Why Choose Crewtec for Enterprise IT
          </h2>
          <p class="max-w-2xl mx-auto text-base" style="color:rgba(255,255,255,0.6);">
            Decades of combined experience, vendor certifications, and a security-first culture — here's what sets us apart.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {whyCards.map(card => (
            <div class="rounded-2xl p-8" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);">
              <div class="text-4xl mb-4">{card.icon}</div>
              <h3
                class="text-xl font-bold text-white mb-3"
                style="font-family:'Syne',sans-serif;"
              >
                {card.title}
              </h3>
              <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.65);">{card.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════ -->
    <!-- 6. PROCESS TIMELINE                            -->
    <!-- ═══════════════════════════════════════════════ -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-14 text-center">
          <h2
            class="text-3xl lg:text-4xl font-extrabold mb-4"
            style="font-family:'Syne',sans-serif;color:#0A1628;"
          >
            Our IT Solution Delivery Process
          </h2>
          <p class="text-gray-500 max-w-xl mx-auto">
            A structured, five-stage approach from initial assessment through to ongoing support.
          </p>
        </div>

        <!-- Desktop timeline -->
        <div class="hidden lg:flex items-start gap-0">
          {processSteps.map((step, idx) => (
            <div class="flex-1 relative">
              <!-- Connector line -->
              {idx < processSteps.length - 1 && (
                <div
                  class="absolute top-6 left-1/2 right-0 h-0.5"
                  style="background:linear-gradient(90deg,#0099EE,rgba(0,153,238,0.2));"
                ></div>
              )}
              <div class="flex flex-col items-center text-center px-4">
                <div
                  class="w-12 h-12 rounded-full flex items-center justify-center text-sm font-bold text-white mb-4 relative z-10 shrink-0"
                  style="background:#0099EE;"
                >
                  {step.num}
                </div>
                <h4
                  class="text-sm font-bold mb-2"
                  style="font-family:'Syne',sans-serif;color:#0A1628;"
                >
                  {step.title}
                </h4>
                <p class="text-xs text-gray-500 leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Mobile timeline -->
        <div class="flex flex-col gap-0 lg:hidden">
          {processSteps.map((step, idx) => (
            <div class="flex gap-5">
              <!-- Left: number + line -->
              <div class="flex flex-col items-center">
                <div
                  class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white shrink-0"
                  style="background:#0099EE;"
                >
                  {step.num}
                </div>
                {idx < processSteps.length - 1 && (
                  <div class="w-0.5 flex-1 my-2" style="background:rgba(0,153,238,0.25);"></div>
                )}
              </div>
              <!-- Right: content -->
              <div class="pb-8">
                <h4
                  class="font-bold mb-1"
                  style="font-family:'Syne',sans-serif;color:#0A1628;"
                >
                  {step.title}
                </h4>
                <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════ -->
    <!-- 7. CTA BANNER                                  -->
    <!-- ═══════════════════════════════════════════════ -->
    <section class="py-20" style="background:#0099EE;">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2
          class="text-3xl lg:text-4xl font-extrabold text-white mb-6"
          style="font-family:'Syne',sans-serif;"
        >
          Ready to Secure and Scale Your Enterprise IT?
        </h2>
        <p class="text-lg mb-10" style="color:rgba(255,255,255,0.85);">
          Talk to our certified engineers today. We'll assess your current posture, recommend the right solutions, and give you a clear, no-obligation roadmap.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center px-8 py-4 rounded-xl font-bold text-[#0099EE] bg-white text-base transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
          >
            Get a Free IT Consultation →
          </a>
          <a
            href="#solutions"
            class="inline-flex items-center px-8 py-4 rounded-xl font-bold text-white text-base border-2 border-white border-opacity-40 transition-all duration-200 hover:bg-white hover:text-[#0099EE]"
          >
            Browse All Solutions
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
