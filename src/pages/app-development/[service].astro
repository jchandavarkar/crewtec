---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { appServices } from '../../data/appDevelopment.js';

export async function getStaticPaths() {
  return appServices.map(s => ({ params: { service: s.id }, props: { service: s } }));
}
const { service: svc } = Astro.props;
const related = appServices.filter(s => s.id !== svc.id).slice(0, 3);

const LOGO_TOKEN = 'pk_QjVOM58vT--W_C9INwBCvg';
---

<BaseLayout
  title={`${svc.name} | Crewtec App Development`}
  description={svc.metaDesc}
  canonical={`/app-development/${svc.id}`}
>
  <Header backLink={true} />
  <main>

    <!-- ═══════════════════════════════════════════════
         HERO — navy bg, dot-grid
    ═══════════════════════════════════════════════ -->
    <section class="as-hero">
      <div class="as-hero-inner">
        <!-- Breadcrumb -->
        <nav class="as-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/app-development">App Development</a>
          <span>/</span>
          <span>{svc.name}</span>
        </nav>

        <!-- Service badge -->
        <span class="as-badge">Service {svc.number}</span>

        <h1 class="as-hero-h1">{svc.name}</h1>
        <p class="as-hero-desc">{svc.fullDesc}</p>

        <!-- Results strip -->
        <div class="as-results-strip">
          {svc.results.map(r => (
            <div class="as-result-item">
              <span class="as-result-val">{r.value}</span>
              <span class="as-result-lbl">{r.label}</span>
            </div>
          ))}
        </div>

        <a href="#quote" class="as-hero-cta">Start This Project →</a>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         TWO-COL BODY
    ═══════════════════════════════════════════════ -->
    <div class="as-body">
      <div class="as-body-inner">

        <!-- ── LEFT COLUMN ──────────────────────── -->
        <div class="as-content">

          <!-- Section 1: Process -->
          <section class="as-section">
            <h2 class="as-section-h2">Our {svc.name} Process</h2>
            <div class="as-timeline">
              {svc.process.map((step, i) => (
                <div class="as-timeline-item">
                  <div class="as-timeline-left">
                    <div class="as-timeline-num">{String(i + 1).padStart(2, '0')}</div>
                    {i < svc.process.length - 1 && <div class="as-timeline-line"></div>}
                  </div>
                  <div class="as-timeline-content">
                    <h3 class="as-timeline-title">{step.title}</h3>
                    <p class="as-timeline-desc">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Section 2: Features -->
          <section class="as-section">
            <h2 class="as-section-h2">What's Included</h2>
            <div class="as-features-grid">
              {svc.features.map(f => (
                <div class="as-feature-card">
                  <span class="as-feat-check">✓</span>
                  <span class="as-feat-text">{f}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Section 3: Tech Stack -->
          {svc.tech && svc.tech.length > 0 && (
            <section class="as-section">
              <h2 class="as-section-h2">Tools &amp; Technology</h2>
              <div class="as-tools-grid">
                {svc.tech.map(tool => (
                  <div class="as-tool-card">
                    <div class="as-tool-logo-wrap">
                      <img
                        src={`https://img.logo.dev/${tool.domain}?token=${LOGO_TOKEN}&size=80&format=webp`}
                        alt={`${tool.name} logo`}
                        width="48"
                        height="48"
                        loading="lazy"
                        onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
                      />
                      <span
                        class="as-tool-fallback"
                        style="display:none;width:48px;height:48px;background:rgba(99,102,241,0.12);color:#6366F1;border-radius:10px;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;"
                      >
                        {tool.name.slice(0, 2).toUpperCase()}
                      </span>
                    </div>
                    <div class="as-tool-info">
                      <span class="as-tool-name">{tool.name}</span>
                      <span class="as-tool-type">{tool.type}</span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Section 4: Use Cases -->
          <section class="as-section">
            <h2 class="as-section-h2">What We Help You Achieve</h2>
            <div class="as-usecases">
              {svc.useCases.map(uc => (
                <div class="as-usecase-card">
                  <span class="as-uc-check">✓</span>
                  <span class="as-uc-text">{uc}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Section 5: Related Services -->
          <section class="as-section">
            <h2 class="as-section-h2">Related Services</h2>
            <div class="as-related-grid">
              {related.map(r => (
                <a href={`/app-development/${r.id}`} class="as-related-card">
                  <div class="as-related-icon-wrap">
                    <span class="as-related-icon">{r.icon}</span>
                  </div>
                  <div class="as-related-info">
                    <span class="as-related-name">{r.name}</span>
                    <span class="as-related-desc">{r.shortDesc}</span>
                  </div>
                  <span class="as-related-arrow">→</span>
                </a>
              ))}
            </div>
          </section>

        </div>

        <!-- ── RIGHT COLUMN (sticky) ─────────────── -->
        <aside class="as-sidebar" id="quote">
          <div class="as-sidebar-sticky">
            <div class="as-sidebar-banner">
              <p>Ready to build <strong>{svc.name}</strong>? Our engineers are here to help.</p>
            </div>
            <QuoteForm prefill={svc.id} />
            <div class="as-contact-strip">
              <a href="tel:+919986437648">📞 +91 99864 37648</a>
              <a href="mailto:sales@crewtec.in">✉️ sales@crewtec.in</a>
            </div>
          </div>
        </aside>

      </div>
    </div>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ── HERO ─────────────────────────────────────── */
.as-hero {
  background: #0A1628;
  padding: 64px 0 56px;
  position: relative;
  overflow: hidden;
}
.as-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(99,102,241,0.12) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
}
.as-hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 1;
}
.as-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.4);
  margin-bottom: 20px;
  flex-wrap: wrap;
}
.as-breadcrumb a { color: rgba(255,255,255,0.4); transition: color 0.2s; }
.as-breadcrumb a:hover { color: #6366F1; }
.as-breadcrumb span:last-child { color: rgba(255,255,255,0.65); }

.as-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #6366F1;
  background: rgba(99,102,241,0.12);
  border: 1px solid rgba(99,102,241,0.25);
  padding: 4px 12px;
  border-radius: 100px;
  margin-bottom: 16px;
}

.as-hero-h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2rem, 4.5vw, 3rem);
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  margin-bottom: 16px;
  max-width: 720px;
}
.as-hero-desc {
  font-size: 1rem;
  color: rgba(255,255,255,0.6);
  max-width: 620px;
  line-height: 1.7;
  margin-bottom: 32px;
}
.as-results-strip {
  display: flex;
  gap: 40px;
  flex-wrap: wrap;
  margin-bottom: 32px;
  padding: 20px 24px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  width: fit-content;
}
.as-result-item { text-align: center; }
.as-result-val {
  display: block;
  font-family: 'Syne', sans-serif;
  font-size: 1.6rem;
  font-weight: 800;
  color: #6366F1;
}
.as-result-lbl {
  display: block;
  font-size: 0.72rem;
  color: rgba(255,255,255,0.5);
  margin-top: 4px;
  max-width: 140px;
  line-height: 1.4;
}
.as-hero-cta {
  display: inline-flex;
  align-items: center;
  padding: 14px 28px;
  background: #6366F1;
  color: #fff;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.95rem;
  box-shadow: 0 4px 20px rgba(99,102,241,0.4);
  transition: background 0.2s, transform 0.2s;
}
.as-hero-cta:hover { background: #4f52d9; transform: translateY(-2px); }

/* ── TWO-COL BODY ─────────────────────────────── */
.as-body {
  background: #F5F9FF;
  padding: 56px 0 80px;
}
.as-body-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 40px;
  align-items: start;
}
@media (max-width: 1024px) {
  .as-body-inner { grid-template-columns: 1fr; }
  .as-sidebar-sticky { position: static !important; }
}

/* ── SECTIONS ─────────────────────────────────── */
.as-section { margin-bottom: 48px; }
.as-section-h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #0A1628;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 2px solid #e8eef5;
}

/* ── PROCESS TIMELINE ─────────────────────────── */
.as-timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.as-timeline-item {
  display: flex;
  gap: 20px;
  align-items: flex-start;
}
.as-timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.as-timeline-num {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #6366F1;
  color: #fff;
  font-family: 'Syne', sans-serif;
  font-size: 0.75rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.as-timeline-line {
  width: 2px;
  flex: 1;
  min-height: 28px;
  background: #d0dce8;
  margin: 6px 0;
}
.as-timeline-content {
  background: #fff;
  border: 1.5px solid #e8eef5;
  border-radius: 12px;
  padding: 18px 20px;
  margin-bottom: 12px;
  flex: 1;
}
.as-timeline-title {
  font-family: 'Syne', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  color: #0A1628;
  margin-bottom: 6px;
}
.as-timeline-desc {
  font-size: 0.85rem;
  color: #5a738a;
  line-height: 1.65;
  margin: 0;
}

/* ── FEATURES ─────────────────────────────────── */
.as-features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
@media (max-width: 640px) {
  .as-features-grid { grid-template-columns: 1fr; }
}
.as-feature-card {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: #fff;
  border: 1.5px solid #e8eef5;
  border-radius: 10px;
  padding: 14px 16px;
}
.as-feat-check {
  color: #6366F1;
  font-weight: 700;
  font-size: 0.8rem;
  margin-top: 2px;
  flex-shrink: 0;
}
.as-feat-text {
  font-size: 0.84rem;
  color: #3d5166;
  line-height: 1.5;
}

/* ── TOOLS ────────────────────────────────────── */
.as-tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
@media (max-width: 640px) {
  .as-tools-grid { grid-template-columns: repeat(2, 1fr); }
}
.as-tool-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border: 1.5px solid #e8eef5;
  border-radius: 12px;
  padding: 14px 16px;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.as-tool-card:hover {
  border-color: #6366F1;
  box-shadow: 0 4px 16px rgba(99,102,241,0.1);
}
.as-tool-logo-wrap {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  border: 1px solid #e8eef5;
  background: #f8fbff;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.as-tool-logo-wrap img {
  width: 40px;
  height: 40px;
  object-fit: contain;
}
.as-tool-info { flex: 1; min-width: 0; }
.as-tool-name {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  color: #0A1628;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.as-tool-type {
  display: block;
  font-size: 0.72rem;
  color: #5a738a;
  text-transform: capitalize;
}

/* ── USE CASES ────────────────────────────────── */
.as-usecases {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.as-usecase-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: #fff;
  border: 1.5px solid #e8eef5;
  border-radius: 10px;
  padding: 16px 18px;
}
.as-uc-check {
  width: 24px;
  height: 24px;
  min-width: 24px;
  border-radius: 6px;
  background: rgba(99,102,241,0.1);
  color: #6366F1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.72rem;
  font-weight: 700;
}
.as-uc-text {
  font-size: 0.875rem;
  color: #3d5166;
  line-height: 1.55;
}

/* ── RELATED ──────────────────────────────────── */
.as-related-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.as-related-card {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #fff;
  border: 1.5px solid #e8eef5;
  border-radius: 12px;
  padding: 16px 18px;
  color: inherit;
  transition: border-color 0.2s, transform 0.2s;
}
.as-related-card:hover {
  border-color: #6366F1;
  transform: translateX(4px);
}
.as-related-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: rgba(99,102,241,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.as-related-icon { font-size: 1.4rem; }
.as-related-info { flex: 1; min-width: 0; }
.as-related-name {
  display: block;
  font-size: 0.9rem;
  font-weight: 600;
  color: #0A1628;
}
.as-related-desc {
  display: block;
  font-size: 0.78rem;
  color: #5a738a;
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.as-related-arrow {
  color: #6366F1;
  font-size: 1rem;
  flex-shrink: 0;
}

/* ── SIDEBAR ──────────────────────────────────── */
.as-sidebar {}
.as-sidebar-sticky {
  position: sticky;
  top: 80px;
}
.as-sidebar-banner {
  background: rgba(99,102,241,0.07);
  border: 1px solid rgba(99,102,241,0.18);
  border-radius: 10px;
  padding: 12px 16px;
  margin-bottom: 14px;
}
.as-sidebar-banner p {
  font-size: 0.85rem;
  color: #0A1628;
  margin: 0;
  line-height: 1.5;
}
.as-sidebar-banner strong { color: #6366F1; }
.as-contact-strip {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 14px;
  padding: 14px 16px;
  background: #fff;
  border: 1.5px solid #e8eef5;
  border-radius: 12px;
}
.as-contact-strip a {
  font-size: 0.85rem;
  color: #6366F1;
  font-weight: 500;
  transition: color 0.2s;
}
.as-contact-strip a:hover { color: #4f52d9; }
</style>
